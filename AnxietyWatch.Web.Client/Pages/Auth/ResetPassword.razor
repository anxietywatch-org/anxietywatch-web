@page "/reset-password"
@using System.ComponentModel.DataAnnotations
@inject IAuthService AuthService
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>Restablecer contraseña | AnxietyWatch</PageTitle>

<section class="reset-shell" aria-labelledby="reset-title">
    <div class="reset-card">
        <header class="reset-header">
            <span class="reset-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24"><rect x="5" y="10" width="14" height="11" rx="2" /><path d="M8 10V7a4 4 0 0 1 8 0v3" /></svg>
            </span>
            <h1 id="reset-title">Crea una nueva contraseña</h1>
            <p>La nueva contraseña debe tener entre 8 y 30 caracteres.</p>
        </header>

        @if (isResolvingToken)
        {
            <div class="reset-status" role="status">
                Validando tu enlace de recuperación...
            </div>
        }
        else if (string.IsNullOrWhiteSpace(resolvedToken))
        {
            <div class="reset-error" role="alert">
                El enlace de recuperación no contiene un token válido. Solicita uno nuevo.
            </div>
            <a class="back-to-login" href="/forgot-password">Solicitar otro enlace</a>
        }
        else
        {
            <EditForm Model="form" OnValidSubmit="ResetAsync" class="reset-form">
                <DataAnnotationsValidator />

                <div class="reset-field">
                    <label for="new-password">Nueva contraseña</label>
                    <InputText id="new-password"
                               class="form-input"
                               type="password"
                               autocomplete="new-password"
                               disabled="@isSubmitting"
                               @bind-Value="form.NewPassword" />
                    <ValidationMessage For="@(() => form.NewPassword)" />
                </div>

                <div class="reset-field">
                    <label for="confirm-password">Confirmar contraseña</label>
                    <InputText id="confirm-password"
                               class="form-input"
                               type="password"
                               autocomplete="new-password"
                               disabled="@isSubmitting"
                               @bind-Value="form.ConfirmPassword" />
                    <ValidationMessage For="@(() => form.ConfirmPassword)" />
                </div>

                @if (!string.IsNullOrWhiteSpace(errorMessage))
                {
                    <div class="reset-error" role="alert">@errorMessage</div>
                }

                <button class="reset-submit" type="submit" disabled="@isSubmitting" aria-busy="@isSubmitting">
                    @(isSubmitting ? "Actualizando..." : "Restablecer contraseña")
                </button>
            </EditForm>

            <a class="back-to-login" href="/login">Volver al inicio de sesión</a>
        }
    </div>
</section>

@code {
    [SupplyParameterFromQuery(Name = "token")]
    public string? QueryToken { get; set; }

    private readonly ResetPasswordForm form = new();
    private string? resolvedToken;
    private bool isResolvingToken = true;
    private bool isSubmitting;
    private string? errorMessage;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        var consumedToken = QueryToken;
        try
        {
            consumedToken = await JS.InvokeAsync<string>("anxietyWatch.authToken.consume");
        }
        catch (JSException)
        {
            if (!string.IsNullOrWhiteSpace(QueryToken))
            {
                Navigation.NavigateTo("/reset-password", replace: true);
            }
        }
        finally
        {
            resolvedToken = ResolveToken(consumedToken, QueryToken);
            isResolvingToken = false;
            StateHasChanged();
        }
    }

    private async Task ResetAsync()
    {
        if (string.IsNullOrWhiteSpace(resolvedToken) || isSubmitting) return;

        isSubmitting = true;
        errorMessage = null;
        try
        {
            await AuthService.ResetPasswordAsync(new ResetPasswordRequest
            {
                Token = resolvedToken,
                NewPassword = form.NewPassword
            });
            Navigation.NavigateTo("/login?passwordReset=true", replace: true);
        }
        catch (ApiException exception) when (exception.StatusCode == 410)
        {
            errorMessage = "El enlace de recuperación expiró o ya fue utilizado. Solicita uno nuevo.";
        }
        catch (ApiException exception)
        {
            errorMessage = ApiErrorMessages.For(exception, "No pudimos restablecer la contraseña.");
        }
        catch (HttpRequestException)
        {
            errorMessage = "No pudimos conectar con el servicio. Inténtalo nuevamente.";
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private sealed class ResetPasswordForm
    {
        [Required(ErrorMessage = "La nueva contraseña es obligatoria.")]
        [StringLength(30, MinimumLength = 8, ErrorMessage = "La contraseña debe tener entre 8 y 30 caracteres.")]
        public string NewPassword { get; set; } = string.Empty;

        [Required(ErrorMessage = "Confirma la nueva contraseña.")]
        [Compare(nameof(NewPassword), ErrorMessage = "Las contraseñas no coinciden.")]
        public string ConfirmPassword { get; set; } = string.Empty;
    }

    private static string? ResolveToken(string? consumedToken, string? queryToken) =>
        !string.IsNullOrWhiteSpace(consumedToken)
            ? consumedToken
            : queryToken;
}
