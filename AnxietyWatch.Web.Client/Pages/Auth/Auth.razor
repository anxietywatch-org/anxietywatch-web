@page "/login"
@page "/register"
@using System.ComponentModel.DataAnnotations
@using System.Globalization
@using AnxietyWatch.Web.Client.Models.Api
@inject IAuthService AuthService
@inject IAuthSessionManager SessionManager
@inject IPlanService PlanService
@inject IBillingService BillingService
@inject NavigationManager Navigation
@implements IDisposable

<PageTitle>@(isLoginView ? "Iniciar sesión" : "Crear cuenta") | AnxietyWatch</PageTitle>

<section class="auth-shell">
    <div class="@GetAuthCardClass()">
        <nav class="auth-tabs" role="tablist" aria-label="Acceso a AnxietyWatch">
            <button type="button"
                    role="tab"
                    aria-selected="@isLoginView"
                    class="@(isLoginView ? "is-active" : null)"
                    @onclick="ShowLogin">
                Iniciar sesión
            </button>
            <button type="button"
                    role="tab"
                    aria-selected="@(!isLoginView)"
                    class="@(!isLoginView ? "is-active" : null)"
                    @onclick="ShowRegister">
                Crear cuenta
            </button>
        </nav>

        @if (!string.IsNullOrWhiteSpace(authError))
        {
            <div class="auth-alert auth-alert--error" role="alert">@authError</div>
        }

        @if (isLoginView && PasswordReset)
        {
            <div class="auth-alert auth-alert--success" role="status">Contraseña actualizada. Ya puedes iniciar sesión.</div>
        }

        @if (isLoginView)
        {
            <div class="auth-view auth-view--login">
                <header class="auth-heading">
                    <span class="auth-heading__mark" aria-hidden="true">
                        <svg viewBox="0 0 24 24">
                            <path d="M12 21c4.5-2.7 7-6.4 7-10.2A4.8 4.8 0 0 0 14.2 6c-.9 0-1.7.2-2.2.8A3 3 0 0 0 9.8 6 4.8 4.8 0 0 0 5 10.8C5 14.6 7.5 18.3 12 21Z" />
                            <path d="M8.3 12h2l1.1-2.3 1.6 4.6 1.1-2.3h1.8" />
                        </svg>
                    </span>
                    <h1>Bienvenido de vuelta</h1>
                    <p>Continúa cuidando de tu bienestar con AnxietyWatch.</p>
                </header>

                <EditForm Model="loginModel" OnValidSubmit="HandleLogin" class="auth-form">
                    <DataAnnotationsValidator />

                    <div class="auth-field">
                        <label for="login-email">Correo electrónico</label>
                        <div class="input-icon-wrapper">
                            <svg class="input-icon-element auth-field-icon" viewBox="0 0 24 24" aria-hidden="true">
                                <rect x="3" y="5" width="18" height="14" rx="2" />
                                <path d="m4 7 8 6 8-6" />
                            </svg>
                            <InputText id="login-email"
                                       class="form-input auth-input input-with-padding"
                                       type="email"
                                       autocomplete="email"
                                       placeholder="correo@ejemplo.com"
                                       @bind-Value="loginModel.Email" />
                        </div>
                        <ValidationMessage For="@(() => loginModel.Email)" />
                    </div>

                    <div class="auth-field">
                        <div class="field-label-row">
                            <label for="login-password">Contraseña</label>
                            <a href="/forgot-password">¿Olvidaste tu contraseña?</a>
                        </div>
                        <div class="input-icon-wrapper">
                            <svg class="input-icon-element auth-field-icon" viewBox="0 0 24 24" aria-hidden="true">
                                <rect x="5" y="10" width="14" height="11" rx="2" />
                                <path d="M8 10V7a4 4 0 0 1 8 0v3" />
                            </svg>
                            <InputText id="login-password"
                                       class="form-input auth-input input-with-padding"
                                       type="@(showLoginPassword ? "text" : "password")"
                                       autocomplete="current-password"
                                       placeholder="Tu contraseña"
                                       @bind-Value="loginModel.Password" />
                            <button class="auth-password-toggle"
                                    type="button"
                                    aria-label="@(showLoginPassword ? "Ocultar contraseña" : "Mostrar contraseña")"
                                    aria-pressed="@showLoginPassword"
                                    @onclick="() => showLoginPassword = !showLoginPassword">
                                @if (showLoginPassword)
                                {
                                    <svg viewBox="0 0 24 24" aria-hidden="true">
                                        <path d="M3 3l18 18M10.6 10.7A2 2 0 0 0 13.3 13.4M9.9 5.2A10.8 10.8 0 0 1 12 5c5.5 0 9 7 9 7a16.5 16.5 0 0 1-2.2 3.1M6.2 6.2C4.2 7.6 3 12 3 12s3.5 7 9 7a9.7 9.7 0 0 0 3.3-.6" />
                                    </svg>
                                }
                                else
                                {
                                    <svg viewBox="0 0 24 24" aria-hidden="true">
                                        <path d="M3 12s3.5-7 9-7 9 7 9 7-3.5 7-9 7-9-7-9-7Z" />
                                        <circle cx="12" cy="12" r="2.5" />
                                    </svg>
                                }
                            </button>
                        </div>
                        <ValidationMessage For="@(() => loginModel.Password)" />
                    </div>

                    <button class="auth-primary auth-primary--sage"
                            type="submit"
                            disabled="@isSubmitting"
                            aria-busy="@isSubmitting">
                        @(isSubmitting ? "Iniciando sesión..." : "Iniciar sesión")
                    </button>
                </EditForm>
            </div>
        }
        else
        {
            <ol class="register-steps" aria-label="Progreso del registro">
                <li class="@GetStepClass(1)"><span>1</span><strong>Datos</strong></li>
                <li class="register-steps__line @(registerStep >= 2 ? "is-active" : null)" aria-hidden="true"></li>
                <li class="@GetStepClass(2)"><span>2</span><strong>Plan</strong></li>
            </ol>

            @if (registerStep == 1)
            {
                <div class="auth-view">
                    <header class="auth-heading">
                        <h1>Crea tu cuenta</h1>
                        <p>Empieza a registrar y comprender mejor tu bienestar.</p>
                    </header>

                    <EditForm Model="registerModel" OnValidSubmit="ContinueToPlan" class="auth-form">
                        <DataAnnotationsValidator />

                        <div class="auth-field">
                            <label for="register-name">Nombre completo</label>
                            <div class="input-icon-wrapper">
                                <svg class="input-icon-element auth-field-icon" viewBox="0 0 24 24" aria-hidden="true">
                                    <circle cx="12" cy="8" r="3.5" />
                                    <path d="M5 20c.5-5 2.8-7.5 7-7.5s6.5 2.5 7 7.5" />
                                </svg>
                                <InputText id="register-name"
                                           class="form-input auth-input input-with-padding"
                                           autocomplete="name"
                                           placeholder="Tu nombre y apellidos"
                                           @bind-Value="registerModel.FullName" />
                            </div>
                            <ValidationMessage For="@(() => registerModel.FullName)" />
                        </div>

                        <div class="auth-field">
                            <label for="register-email">Correo electrónico</label>
                            <div class="input-icon-wrapper">
                                <svg class="input-icon-element auth-field-icon" viewBox="0 0 24 24" aria-hidden="true">
                                    <rect x="3" y="5" width="18" height="14" rx="2" />
                                    <path d="m4 7 8 6 8-6" />
                                </svg>
                                <InputText id="register-email"
                                           class="form-input auth-input input-with-padding"
                                           type="email"
                                           autocomplete="email"
                                           placeholder="correo@ejemplo.com"
                                           @bind-Value="registerModel.Email" />
                            </div>
                            <ValidationMessage For="@(() => registerModel.Email)" />
                            @if (!string.IsNullOrWhiteSpace(registerEmailError))
                            {
                                <div class="validation-message" role="alert">@registerEmailError</div>
                            }
                        </div>

                        <div class="auth-field">
                            <label for="register-password">Contraseña</label>
                            <div class="input-icon-wrapper">
                                <svg class="input-icon-element auth-field-icon" viewBox="0 0 24 24" aria-hidden="true">
                                    <rect x="5" y="10" width="14" height="11" rx="2" />
                                    <path d="M8 10V7a4 4 0 0 1 8 0v3" />
                                </svg>
                                <InputText id="register-password"
                                           class="form-input auth-input input-with-padding"
                                           type="@(showRegisterPassword ? "text" : "password")"
                                           autocomplete="new-password"
                                           placeholder="Mínimo 8 caracteres"
                                           @bind-Value="registerModel.Password" />
                                <button class="auth-password-toggle"
                                        type="button"
                                        aria-label="@(showRegisterPassword ? "Ocultar contraseña" : "Mostrar contraseña")"
                                        aria-pressed="@showRegisterPassword"
                                        @onclick="() => showRegisterPassword = !showRegisterPassword">
                                    @if (showRegisterPassword)
                                    {
                                        <svg viewBox="0 0 24 24" aria-hidden="true">
                                            <path d="M3 3l18 18M10.6 10.7A2 2 0 0 0 13.3 13.4M9.9 5.2A10.8 10.8 0 0 1 12 5c5.5 0 9 7 9 7a16.5 16.5 0 0 1-2.2 3.1M6.2 6.2C4.2 7.6 3 12 3 12s3.5 7 9 7a9.7 9.7 0 0 0 3.3-.6" />
                                        </svg>
                                    }
                                    else
                                    {
                                        <svg viewBox="0 0 24 24" aria-hidden="true">
                                            <path d="M3 12s3.5-7 9-7 9 7 9 7-3.5 7-9 7-9-7-9-7Z" />
                                            <circle cx="12" cy="12" r="2.5" />
                                        </svg>
                                    }
                                </button>
                            </div>
                            <ValidationMessage For="@(() => registerModel.Password)" />
                        </div>

                        <button class="auth-primary auth-primary--sage" type="submit">Continuar</button>
                    </EditForm>
                </div>
            }
            else
            {
                <div class="auth-view auth-view--plans">
                    <header class="auth-heading">
                        <h1>Elige tu plan</h1>
                        <p>Selecciona la opción que mejor se adapta a tus necesidades.</p>
                    </header>

                    <EditForm Model="registerModel" OnValidSubmit="CompleteRegistrationAsync" class="auth-form">
                        @if (isPlansLoading)
                        {
                            <div class="auth-alert" role="status">Cargando planes...</div>
                        }
                        else if (!string.IsNullOrWhiteSpace(plansError))
                        {
                            <div class="auth-alert auth-alert--error" role="alert">
                                @plansError
                                <button type="button" @onclick="LoadPlansAsync">Reintentar</button>
                            </div>
                        }
                        else if (plans.Count == 0)
                        {
                            <div class="auth-alert" role="status">No hay planes disponibles para completar el registro.</div>
                        }
                        else
                        {
                            <div class="auth-plan-grid" role="radiogroup" aria-label="Planes disponibles">
                            @foreach (var plan in plans)
                            {
                                <button class="@GetPlanCardClass(plan)"
                                        type="button"
                                        role="radio"
                                        aria-checked="@(selectedPlanId == plan.Id)"
                                        @onclick="() => SelectPlan(plan.Id)">
                                    <span class="plan-radio" aria-hidden="true"></span>
                                    <strong>@plan.Name</strong>
                                    <span class="plan-price">@FormatMonthlyPrice(plan)</span>
                                    <small>@plan.IdealFor</small>
                                </button>
                            }
                            </div>

                            @if (SelectedPlan is { } selectedPlan)
                            {
                            <section class="plan-feature-box @GetSelectedPlanToneClass()" aria-labelledby="selected-plan-title">
                                <header>
                                    <div>
                                        <span>Plan seleccionado</span>
                                        <h2 id="selected-plan-title">@selectedPlan.Name</h2>
                                    </div>
                                    <strong>@FormatMonthlyPrice(selectedPlan)</strong>
                                </header>
                                <ul>
                                    @foreach (var feature in selectedPlan.Features)
                                    {
                                        <li><span aria-hidden="true">✓</span>@feature</li>
                                    }
                                </ul>
                                @if (!IsFreePlan(selectedPlan))
                                {
                                    <div class="simulated-checkout" aria-labelledby="checkout-title">
                                        <div class="simulated-checkout__header">
                                            <div><span>Checkout de demostración</span><h3 id="checkout-title">Pago seguro simulado</h3></div>
                                            <div class="payment-brands" aria-label="Métodos disponibles"><span class="payment-brand payment-brand--visa">VISA</span><span class="payment-brand payment-brand--mastercard">●● Mastercard</span><span class="payment-brand payment-brand--paypal">PayPal</span><span class="payment-brand payment-brand--kueski">Kueski</span></div>
                                        </div>
                                        <label for="demo-card-number">Número de tarjeta de prueba</label>
                                        <input id="demo-card-number" class="form-input" inputmode="numeric" autocomplete="off" maxlength="19" placeholder="4242 4242 4242 4242" @bind="demoCardNumber" @bind:event="oninput" />
                                        @if (!string.IsNullOrWhiteSpace(demoCardNumber)) { <small class="payment-card-hint">Red detectada: <strong>@DetectedCardBrand</strong>. El dato solo vive en memoria y nunca se envía al backend.</small> }
                                        <div class="simulated-checkout__row"><label for="demo-expiry">Vencimiento<input id="demo-expiry" class="form-input" inputmode="numeric" autocomplete="off" maxlength="5" placeholder="MM/AA" @bind="demoExpiry" @bind:event="oninput" /></label><label for="demo-cvv">CVV de prueba<input id="demo-cvv" class="form-input" inputmode="numeric" autocomplete="off" maxlength="4" placeholder="123" @bind="demoCvv" @bind:event="oninput" /></label></div>
                                        <p class="payment-security-note">Simulación sin cargos reales. No guardamos ni transmitimos tarjeta, CVV o método de pago.</p>
                                    </div>
                                }
                            </section>

                            }
                        }

                        <div class="register-actions">
                            <button class="auth-back-button" type="button" @onclick="BackToData">← Atrás</button>
                            <button class="plan-primary @GetSelectedPlanToneClass()"
                                    type="submit"
                                    disabled="@(SelectedPlan is null || isPlansLoading || isSubmitting)">
                                @(isSubmitting ? "Procesando..." : GetPlanActionText())
                            </button>
                        </div>
                    </EditForm>
                </div>
            }
        }
    </div>
</section>

@code {
    [SupplyParameterFromQuery(Name = "plan")]
    public string? RequestedPlan { get; set; }

    [SupplyParameterFromQuery(Name = "cycle")]
    public string? RequestedBillingCycle { get; set; }

    [SupplyParameterFromQuery(Name = "passwordReset")]
    public bool PasswordReset { get; set; }

    private readonly LoginModel loginModel = new();
    private readonly RegisterModel registerModel = new();
    private readonly CancellationTokenSource cancellationTokenSource = new();

    private bool isLoginView = true;
    private int registerStep = 1;
    private string? selectedPlanId;
    private string billingCycle = "monthly";
    private bool showLoginPassword;
    private bool showRegisterPassword;
    private bool isSubmitting;
    private string? authError;
    private string? registerEmailError;
    private IReadOnlyList<PlanDto> plans = [];
    private bool isPlansLoading = true;
    private string? plansError;
    private string demoCardNumber = string.Empty;
    private string demoExpiry = string.Empty;
    private string demoCvv = string.Empty;

    private PlanDto? SelectedPlan => plans.FirstOrDefault(plan => plan.Id == selectedPlanId);
    private string DetectedCardBrand => DetectCardBrand(demoCardNumber);

    protected override void OnParametersSet()
    {
        var path = new Uri(Navigation.Uri).AbsolutePath.TrimEnd('/');
        isLoginView = !path.Equals("/register", StringComparison.OrdinalIgnoreCase);
        billingCycle = RequestedBillingCycle?.Equals("yearly", StringComparison.OrdinalIgnoreCase) == true
            ? "yearly"
            : "monthly";

        ApplyRequestedPlan();
    }

    protected override Task OnInitializedAsync() => LoadPlansAsync();

    private void ShowLogin()
    {
        isLoginView = true;
        authError = null;
        Navigation.NavigateTo("/login", replace: true);
    }

    private void ShowRegister()
    {
        isLoginView = false;
        registerStep = 1;
        authError = null;
        Navigation.NavigateTo("/register", replace: true);
    }

    private void ContinueToPlan()
    {
        authError = null;
        registerStep = 2;
    }

    private void BackToData()
    {
        registerStep = 1;
    }

    private void SelectPlan(string planId)
    {
        selectedPlanId = planId;
    }

    private string GetAuthCardClass() => !isLoginView && registerStep == 2
        ? "auth-card auth-card--wide"
        : "auth-card";

    private string GetStepClass(int step) => registerStep >= step
        ? "register-step is-active"
        : "register-step";

    private string GetPlanCardClass(PlanDto plan) =>
        $"auth-plan-card plan-tone--{plan.Id}{(selectedPlanId == plan.Id ? " is-selected" : string.Empty)}";

    private string GetSelectedPlanToneClass() => SelectedPlan is null ? string.Empty : $"plan-tone--{SelectedPlan.Id}";

    private string GetPlanActionText() => SelectedPlan switch
    {
        null => "Selecciona un plan",
        { PriceMonthly: 0 } => "Crear cuenta gratis",
        _ => "Crear cuenta y pagar simulado"
    };

    private string FormatMonthlyPrice(PlanDto plan)
    {
        var price = billingCycle == "yearly" ? plan.PriceYearly : plan.PriceMonthly;
        var period = billingCycle == "yearly" ? "año" : "mes";
        return $"${price.ToString("0.00", CultureInfo.InvariantCulture)}/{period}";
    }

    private async Task HandleLogin()
    {
        isSubmitting = true;
        authError = null;

        try
        {
            var session = await AuthService.LoginAsync(new LoginRequest
            {
                Email = loginModel.Email,
                Password = loginModel.Password
            });
            Navigation.NavigateTo(session.User.EmailVerified ? "/dashboard/tokens" : "/verify-email/pending");
        }
        catch (ApiException exception) when (exception.StatusCode == 401)
        {
            authError = "Correo o contraseña incorrectos.";
        }
        catch (ApiException exception)
        {
            authError = ApiErrorMessages.For(exception, "No pudimos iniciar sesión.");
        }
        catch (Exception)
        {
            authError = "No pudimos iniciar sesión. Inténtalo nuevamente.";
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private async Task CompleteRegistrationAsync()
    {
        if (SelectedPlan is null)
        {
            authError = "Selecciona un plan para completar el registro.";
            return;
        }

        if (!IsFreePlan(SelectedPlan) && !IsDemoPaymentValid())
        {
            authError = "Completa los datos de tarjeta de prueba para continuar con la simulación.";
            return;
        }

        isSubmitting = true;
        authError = null;
        registerEmailError = null;

        try
        {
            try
            {
                await AuthService.RegisterAsync(new RegisterRequest
                {
                    FullName = registerModel.FullName,
                    Email = registerModel.Email,
                    Password = registerModel.Password,
                    // Paid signup is created as free first; the simulated checkout upgrades it immediately
                    // through the authenticated billing endpoint. No card data is included in this request.
                    PlanId = "free",
                    BillingCycle = billingCycle
                });
            }
            catch (ApiException exception) when (exception.StatusCode == 409)
            {
                registerStep = 1;
                authError = null;
                registerEmailError = "Este correo ya tiene una cuenta. Inicia sesión o usa otro correo.";
                return;
            }

            if (!IsFreePlan(SelectedPlan))
            {
                await BillingService.SimulatePaymentAsync(new SimulatePaymentRequest(SelectedPlan.Id, billingCycle));
                // Billing updates the account server-side; refresh the JWT/session snapshot
                // before navigating so the dashboard immediately reflects the purchased plan.
                await SessionManager.RefreshSessionAsync();
            }
            Navigation.NavigateTo("/verify-email/pending");
        }
        catch (ApiException exception)
        {
            authError = ApiErrorMessages.For(exception, "No pudimos crear tu cuenta.");
        }
        catch (Exception)
        {
            authError = "No pudimos crear tu cuenta. Inténtalo nuevamente.";
        }
        finally
        {
            isSubmitting = false;
        }
    }

    public sealed class LoginModel
    {
        [Required(ErrorMessage = "El correo es obligatorio.")]
        [EmailAddress(ErrorMessage = "Introduce un correo electrónico válido.")]
        [StringLength(254, ErrorMessage = "El correo no puede superar los 254 caracteres.")]
        public string Email { get; set; } = string.Empty;

        [Required(ErrorMessage = "La contraseña es obligatoria.")]
        [StringLength(64, ErrorMessage = "La contraseña no puede superar los 64 caracteres.")]
        public string Password { get; set; } = string.Empty;
    }

    public sealed class RegisterModel
    {
        [Required(ErrorMessage = "El nombre es obligatorio.")]
        [StringLength(60, MinimumLength = 2, ErrorMessage = "El nombre debe tener entre 2 y 60 caracteres.")]
        public string FullName { get; set; } = string.Empty;

        [Required(ErrorMessage = "El correo es obligatorio.")]
        [EmailAddress(ErrorMessage = "Introduce un correo electrónico válido.")]
        [StringLength(254, ErrorMessage = "El correo no puede superar los 254 caracteres.")]
        public string Email { get; set; } = string.Empty;

        [Required(ErrorMessage = "La contraseña es obligatoria.")]
        [StringLength(30, MinimumLength = 8, ErrorMessage = "La contraseña debe tener mínimo 8 caracteres.")]
        public string Password { get; set; } = string.Empty;
    }

    private async Task LoadPlansAsync()
    {
        isPlansLoading = true;
        plansError = null;
        try
        {
            plans = await PlanService.GetPlansAsync(cancellationTokenSource.Token);
            ApplyRequestedPlan();
            selectedPlanId ??= plans.FirstOrDefault(IsFreePlan)?.Id;
        }
        catch (ApiException exception)
        {
            plans = [];
            selectedPlanId = null;
            plansError = ApiErrorMessages.For(exception, "No pudimos cargar los planes.");
        }
        catch (OperationCanceledException) when (cancellationTokenSource.IsCancellationRequested)
        {
        }
        catch (Exception)
        {
            plans = [];
            selectedPlanId = null;
            plansError = "No pudimos cargar los planes. Inténtalo nuevamente.";
        }
        finally
        {
            isPlansLoading = false;
        }
    }

    private void ApplyRequestedPlan()
    {
        if (string.IsNullOrWhiteSpace(RequestedPlan) || plans.Count == 0)
        {
            return;
        }

        selectedPlanId = plans.FirstOrDefault(plan =>
            plan.Id.Equals(RequestedPlan.Trim(), StringComparison.OrdinalIgnoreCase))?.Id
            ?? plans.FirstOrDefault(IsFreePlan)?.Id;
    }

    private bool IsDemoPaymentValid() =>
        IsLuhnValid(demoCardNumber) && demoExpiry.Length == 5 && demoCvv.Length is >= 3 and <= 4;

    private static bool IsLuhnValid(string value)
    {
        var digits = new string(value.Where(char.IsDigit).ToArray());
        if (digits.Length < 12 || digits.Length > 19) return false;
        var sum = 0;
        var alternate = false;
        for (var index = digits.Length - 1; index >= 0; index--)
        {
            var digit = digits[index] - '0';
            if (alternate && (digit *= 2) > 9) digit -= 9;
            sum += digit;
            alternate = !alternate;
        }
        return sum % 10 == 0;
    }

    private static string DetectCardBrand(string value)
    {
        var digits = new string(value.Where(char.IsDigit).ToArray());
        if (digits.StartsWith("4", StringComparison.Ordinal)) return "Visa";
        if (digits.Length >= 2 && int.TryParse(digits[..2], out var two) && two is >= 51 and <= 55) return "Mastercard";
        if (digits.StartsWith("6", StringComparison.Ordinal)) return "Kueski / débito";
        if (digits.StartsWith("3", StringComparison.Ordinal)) return "American Express";
        return "No identificada";
    }

    private static bool IsFreePlan(PlanDto plan) =>
        plan.PriceMonthly == 0 && plan.PriceYearly == 0 && plan.Id.Equals("free", StringComparison.OrdinalIgnoreCase);

    public void Dispose() => cancellationTokenSource.Cancel();
}
