@page "/forgot-password"
@using System.ComponentModel.DataAnnotations
@inject IAuthService AuthService

<PageTitle>Recuperar contraseña | AnxietyWatch</PageTitle>

<section class="forgot-password-shell" aria-labelledby="forgot-password-title">
    <div class="forgot-password-card">
        <header class="forgot-password-header">
            <span class="forgot-password-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24">
                    <path d="M12 21c4.5-2.7 7-6.4 7-10.2A4.8 4.8 0 0 0 14.2 6c-.9 0-1.7.2-2.2.8A3 3 0 0 0 9.8 6 4.8 4.8 0 0 0 5 10.8C5 14.6 7.5 18.3 12 21Z" />
                    <rect x="8" y="10" width="8" height="7" rx="1.5" />
                    <path d="M10 10V8a2 2 0 0 1 4 0v2" />
                </svg>
            </span>
            <h1 id="forgot-password-title">Recuperar contraseña</h1>
            <p>Ingresa el correo electrónico asociado a tu cuenta y te enviaremos un enlace para restablecer tu contraseña.</p>
        </header>

        @if (isSuccess)
        {
            <section class="recovery-success" aria-labelledby="recovery-success-title" role="status">
                <span aria-hidden="true">
                    <svg viewBox="0 0 24 24">
                        <path d="m5 12 4 4L19 6" />
                    </svg>
                </span>
                <h2 id="recovery-success-title">Revisa tu correo</h2>
                <p>@successMessage</p>
            </section>
        }
        else
        {
            <EditForm Model="forgotPasswordModel" OnValidSubmit="HandleSubmit" class="forgot-password-form">
                <DataAnnotationsValidator />

                <div class="forgot-password-field">
                    <label for="recovery-email">Correo electrónico</label>
                    <div class="input-icon-wrapper">
                        <svg class="input-icon-element recovery-email-icon" viewBox="0 0 24 24" aria-hidden="true">
                            <rect x="3" y="5" width="18" height="14" rx="2" />
                            <path d="m4 7 8 6 8-6" />
                        </svg>
                        <InputText id="recovery-email"
                                   class="form-input w-full input-with-padding"
                                   type="email"
                                   autocomplete="email"
                                   placeholder="correo@ejemplo.com"
                                   @bind-Value="forgotPasswordModel.Email" />
                    </div>
                    <ValidationMessage For="@(() => forgotPasswordModel.Email)" />
                </div>

                @if (!string.IsNullOrWhiteSpace(errorMessage))
                {
                    <div class="recovery-error" role="alert">@errorMessage</div>
                }

                <button class="recovery-submit"
                        type="submit"
                        disabled="@isSubmitting"
                        aria-busy="@isSubmitting">
                    @if (isSubmitting)
                    {
                        <span class="recovery-spinner" aria-hidden="true"></span>
                        <span>Enviando...</span>
                    }
                    else
                    {
                        <span>Enviar enlace de recuperación</span>
                    }
                </button>
            </EditForm>
        }

        <a class="back-to-login" href="/login">← Volver al inicio de sesión</a>
    </div>
</section>

@code {
    private readonly ForgotPasswordRequest forgotPasswordModel = new();
    private bool isSubmitting = false;
    private bool isSuccess = false;
    private string successMessage = string.Empty;
    private string? errorMessage;

    private async Task HandleSubmit()
    {
        isSubmitting = true;
        errorMessage = null;

        try
        {
            var response = await AuthService.ForgotPasswordAsync(forgotPasswordModel);
            successMessage = string.IsNullOrWhiteSpace(response.Message)
                ? "Si el correo existe, recibirás un enlace para restablecer tu contraseña."
                : response.Message;
            isSuccess = true;
        }
        catch (ApiException exception)
        {
            errorMessage = ApiErrorMessages.For(exception, "No pudimos solicitar la recuperación de contraseña.");
        }
        catch (HttpRequestException)
        {
            errorMessage = "No pudimos conectar con el servicio. Inténtalo nuevamente.";
        }
        finally
        {
            isSubmitting = false;
        }
    }

}
