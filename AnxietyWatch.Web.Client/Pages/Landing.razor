@page "/"
@rendermode ClientRenderModes.WebAssembly
@using System.Globalization
@using AnxietyWatch.Web.Client.Models.Api
@inject IPlanService PlanService
@inject IContentService ContentService
@implements IDisposable

<PageTitle>AnxietyWatch | Monitorea, comprende y actúa</PageTitle>

<div class="landing-page">
    <section id="inicio" class="hero-section" aria-labelledby="hero-title">
        <div class="landing-container hero-grid">
            <div class="hero-copy">
                <p class="hero-badge">
                    <span class="badge-spark" aria-hidden="true">✦</span>
                    Registro y seguimiento personal
                </p>

                <h1 id="hero-title">Monitorea.<br />Comprende.<br /><span class="text-green">Actúa.</span></h1>

                <p class="hero-description">
                    Registra cómo te sientes, consulta la evolución de tus episodios y usa herramientas de vinculación acordes con tu plan.
                </p>

                <div class="hero-actions" aria-label="Acciones principales">
                    <a class="button button--primary" href="/register">Comenzar gratis</a>
                    <a class="button button--outline" href="#pricing">Ver planes</a>
                </div>

                <p class="hero-note">
                    <span aria-hidden="true">✓</span>
                    Sin tarjeta de crédito. Cancela cuando quieras.
                </p>
            </div>

            <div class="widget-stage">
                <span class="widget-orbit widget-orbit--one" aria-hidden="true"></span>
                <span class="widget-orbit widget-orbit--two" aria-hidden="true"></span>

                <article id="caracteristicas" class="status-widget" aria-labelledby="widget-title">
                    <header class="widget-header">
                        <div>
                            <p>Resumen personal</p>
                            <h2 id="widget-title">Estado actual</h2>
                        </div>
                        <span class="live-status"><i aria-hidden="true"></i> Ejemplo ilustrativo</span>
                    </header>

                    <div class="anxiety-summary">
                        <div class="anxiety-score">
                            <strong>42</strong>
                            <span>de 100</span>
                        </div>
                        <div class="anxiety-copy">
                            <span>Nivel de ansiedad</span>
                            <strong>Moderado</strong>
                            <p>Tu nivel se mantiene estable esta semana.</p>
                        </div>
                    </div>

                    <figure class="widget-chart" aria-label="Tendencia simulada del nivel de ansiedad durante siete días">
                        <div class="chart-bars" aria-hidden="true">
                            <span class="chart-bar chart-bar--1"></span>
                            <span class="chart-bar chart-bar--2"></span>
                            <span class="chart-bar chart-bar--3"></span>
                            <span class="chart-bar chart-bar--4"></span>
                            <span class="chart-bar chart-bar--5"></span>
                            <span class="chart-bar chart-bar--6"></span>
                            <span class="chart-bar chart-bar--7"></span>
                        </div>
                        <figcaption class="chart-days" aria-hidden="true">
                            <span>L</span><span>M</span><span>X</span><span>J</span><span>V</span><span>S</span><span>D</span>
                        </figcaption>
                    </figure>

                    <div class="widget-insights">
                        <section class="insight-card insight-card--sleep" aria-label="Tres registros esta semana">
                            <span class="insight-icon" aria-hidden="true">
                                <svg viewBox="0 0 24 24">
                                    <path d="M19 15.5A8 8 0 0 1 8.5 5 7.5 7.5 0 1 0 19 15.5Z" />
                                </svg>
                            </span>
                            <span><small>Registros</small><strong>3 esta semana</strong></span>
                        </section>

                        <section class="insight-card insight-card--state" aria-label="Racha: tres días">
                            <span class="insight-icon" aria-hidden="true">
                                <svg viewBox="0 0 24 24">
                                    <path d="M4 15h3l2-5 3 8 3-7 2 4h3" />
                                </svg>
                            </span>
                            <span><small>Racha</small><strong>3 días</strong></span>
                        </section>
                    </div>
                </article>
            </div>
        </div>
    </section>

    <section id="como-funciona" class="marketing-section how-section" aria-labelledby="how-title">
        <div class="landing-container">
            <header class="section-heading">
                <p class="section-eyebrow">Un proceso sencillo</p>
                <h2 id="how-title">Cómo funciona</h2>
                <p>Empieza a comprender tu bienestar en cuatro pasos claros y seguros.</p>
            </header>

            <ol class="steps-grid">
                <li class="step-card">
                    <span class="step-number" aria-hidden="true">1</span>
                    <h3>Regístrate</h3>
                    <p>Crea tu cuenta y elige el plan que mejor se adapte a ti.</p>
                </li>
                <li class="step-card">
                    <span class="step-number" aria-hidden="true">2</span>
                    <h3>Registra cómo te sientes</h3>
                    <p>Anota tus emociones y nivel de ansiedad cuando lo necesites.</p>
                </li>
                <li class="step-card">
                    <span class="step-number" aria-hidden="true">3</span>
                    <h3>Consulta tu progreso</h3>
                    <p>Observa tendencias y descubre patrones de manera sencilla.</p>
                </li>
                <li class="step-card">
                    <span class="step-number" aria-hidden="true">4</span>
                    <h3>Comparte con quien tú quieras</h3>
                    <p>Tú decides si deseas compartir información con alguien de confianza.</p>
                </li>
            </ol>
        </div>
    </section>

    <section id="recursos" class="marketing-section resources-section" aria-labelledby="resources-title">
        <div class="landing-container">
            <header class="section-heading">
                <p class="section-eyebrow">Funciones disponibles</p>
                <h2 id="resources-title">Herramientas del producto</h2>
                <p>Funciones pensadas para registrar información útil y revisarla con claridad.</p>
            </header>

            <div class="resources-grid">
                <article class="resource-card">
                    <span class="resource-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24">
                            <path d="M4 12h4m8 0h4M7 7l2.5 2.5M17 7l-2.5 2.5M7 17l2.5-2.5M17 17l-2.5-2.5" />
                            <circle cx="12" cy="12" r="3" />
                        </svg>
                    </span>
                    <h3>Registro personal</h3>
                    <p>Anota intensidad, síntomas y contexto de cada episodio para consultar tu evolución.</p>
                </article>
                <article class="resource-card">
                    <span class="resource-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24">
                            <path d="M5 4h10a4 4 0 0 1 4 4v12H8a3 3 0 0 1-3-3V4Zm3 12h11M9 8h6m-6 4h7" />
                        </svg>
                    </span>
                    <h3>Resumen y tendencias</h3>
                    <p>Consulta tu último nivel registrado, actividad semanal, racha e historial reciente.</p>
                </article>
                <article class="resource-card">
                    <span class="resource-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24">
                            <circle cx="9" cy="9" r="3" />
                            <circle cx="17" cy="10" r="2" />
                            <path d="M3.5 20c.4-4 2.2-6 5.5-6s5.1 2 5.5 6m.5-5c2.9 0 4.6 1.7 5 5" />
                        </svg>
                    </span>
                    <h3>Vinculación controlada</h3>
                    <p>Genera tokens para conectar la experiencia móvil respetando los límites de tu plan.</p>
                </article>
            </div>
        </div>
    </section>

    <section class="marketing-section faq-section" aria-labelledby="faq-title">
        <div class="landing-container faq-container">
            <header class="section-heading">
                <p class="section-eyebrow">Resolvemos tus dudas</p>
                <h2 id="faq-title">Preguntas frecuentes</h2>
            </header>

            <div class="faq-list" aria-busy="@isFaqLoading">
                @if (isFaqLoading)
                {
                    <p role="status">Cargando preguntas frecuentes...</p>
                }
                else if (!string.IsNullOrWhiteSpace(faqError))
                {
                    <div role="alert">
                        <p>@faqError</p>
                        <button class="button button--outline" type="button" @onclick="LoadFaqAsync">Reintentar</button>
                    </div>
                }
                else if (faqs.Count == 0)
                {
                    <p>No hay preguntas frecuentes disponibles por el momento.</p>
                }
                else
                {
                    @foreach (var faq in faqs)
                    {
                        <details>
                            <summary>@faq.Question</summary>
                            <p>@faq.Answer</p>
                        </details>
                    }
                }
            </div>
        </div>
    </section>

    <section id="pricing" class="pricing-section" aria-labelledby="pricing-title">
        <div class="landing-container">
            <header class="pricing-header">
                <p class="section-eyebrow">Planes simples y transparentes</p>
                <h2 id="pricing-title">Elige el plan que mejor te acompaña</h2>
                <p>Empieza gratis y cambia de plan cuando tus necesidades evolucionen.</p>

                <div class="billing-toggle" role="group" aria-label="Ciclo de facturación">
                    <button type="button" class="@(isAnnual ? "" : "is-active")" aria-pressed="@(!isAnnual)" disabled="@isPlansLoading" @onclick="() => isAnnual = false">
                        Mensual
                    </button>
                    <button type="button" class="@(isAnnual ? "is-active" : "")" aria-pressed="@isAnnual" disabled="@isPlansLoading" @onclick="() => isAnnual = true">
                        Anual
                    </button>
                </div>
            </header>

            @if (isPlansLoading)
            {
                <p role="status" aria-live="polite">Cargando planes...</p>
            }
            else if (!string.IsNullOrWhiteSpace(plansError))
            {
                <div role="alert">
                    <p>@plansError</p>
                    <button class="button button--outline" type="button" @onclick="LoadPlansAsync">Reintentar</button>
                </div>
            }
            else if (plans.Count == 0)
            {
                <p>No hay planes disponibles por el momento.</p>
            }
            else
            {
                <div class="pricing-grid">
                    @foreach (var plan in plans)
                    {
                        <article class="plan-card">
                            <header>
                                <h3>@plan.Name</h3>
                                <p>@plan.IdealFor</p>
                            </header>
                            <div class="plan-price"><strong>@GetPrice(plan)</strong><span>/@BillingPeriod</span></div>
                            <ul>
                                @foreach (var feature in plan.Features)
                                {
                                    <li>@feature</li>
                                }
                            </ul>
                            <div class="plan-card-actions">
                                <button class="plan-details-button" type="button" disabled="@isPlansLoading" @onclick="() => OpenPlanDetails(plan)">Ver detalles</button>
                                @if (IsFreePlan(plan))
                                {
                                    <a class="plan-button plan-button--outline" href="@GetRegistrationUrl(plan.Id)">Comenzar gratis</a>
                                }
                                else
                                {
                                    <button class="plan-button plan-button--outline" type="button" disabled>Próximamente</button>
                                }
                            </div>
                        </article>
                    }
                </div>
            }
        </div>
    </section>

    <section id="sobre-nosotros" class="marketing-section about-section" aria-labelledby="about-title">
        <div class="landing-container about-panel">
            <p class="section-eyebrow">Nuestra misión</p>
            <h2 id="about-title">Sobre nosotros</h2>
            <p>En AnxietyWatch trabajamos para que el bienestar emocional sea más accesible, comprensible y cercano. Creamos herramientas que ayudan a cada persona a conocer sus patrones y tomar decisiones informadas respetando siempre su privacidad.</p>
        </div>
    </section>

    <section class="marketing-section testimonials-section" aria-labelledby="testimonials-title">
        <div class="landing-container">
            <header class="section-heading">
                <p class="section-eyebrow">Funciones en contexto</p>
                <h2 id="testimonials-title">Escenarios de uso</h2>
                <p>Ejemplos de cómo se organiza la información disponible en AnxietyWatch.</p>
            </header>

            @if (isTestimonialsLoading)
            {
                <p role="status">Cargando experiencias...</p>
            }
            else if (!string.IsNullOrWhiteSpace(testimonialsError))
            {
                <div role="alert">
                    <p>@testimonialsError</p>
                    <button class="button button--outline" type="button" @onclick="LoadTestimonialsAsync">Reintentar</button>
                </div>
            }
            else if (VisibleTestimonials.Count == 0)
            {
                <p>Aún no hay escenarios publicados. Vuelve pronto para conocer nuevas funciones.</p>
            }
            else
            {
                <div class="testimonials-grid">
                    @foreach (var testimonial in VisibleTestimonials)
                    {
                        <article class="testimonial-card">
                            <p class="testimonial-quote">“@testimonial.Quote”</p>
                            <footer class="testimonial-author">
                                <span class="testimonial-avatar" aria-hidden="true">@GetInitials(testimonial.Name!)</span>
                                <span><strong>@testimonial.Name</strong><small>@testimonial.Role</small></span>
                            </footer>
                        </article>
                    }
                </div>
            }
        </div>
    </section>

    @if (selectedPlan is not null)
    {
        <div class="plan-modal-backdrop" role="presentation" @onclick="ClosePlanDetails">
            <section class="plan-modal"
                     role="dialog"
                     aria-modal="true"
                     aria-labelledby="plan-modal-title"
                     @onclick:stopPropagation="true">
                <button class="modal-close" type="button" aria-label="Cerrar detalles del plan" @onclick="ClosePlanDetails">×</button>

                <header class="modal-header">
                    <span class="modal-plan-badge">Plan @selectedPlan.Name</span>
                    <h2 id="plan-modal-title">@selectedPlan.Name</h2>

                    <div class="modal-price">
                        <strong>@GetPrice(selectedPlan)</strong>
                        <span>/@BillingPeriod</span>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(selectedPlan.IdealFor))
                    {
                        <p class="ideal-for"><strong>Ideal para:</strong> @selectedPlan.IdealFor</p>
                    }
                </header>

                @if (selectedPlan.Features.Count > 0)
                {
                    <section class="modal-includes" aria-labelledby="modal-includes-title">
                        <h3 id="modal-includes-title">Todo lo que incluye</h3>
                        <ul>
                            @foreach (var item in selectedPlan.Features)
                            {
                                <li>@item</li>
                            }
                        </ul>
                    </section>
                }

                @if (selectedPlan.Limitations.Count > 0)
                {
                    <section class="modal-includes" aria-labelledby="modal-limitations-title">
                        <h3 id="modal-limitations-title">Limitaciones</h3>
                        <ul>
                            @foreach (var limitation in selectedPlan.Limitations)
                            {
                                <li>@limitation</li>
                            }
                        </ul>
                    </section>
                }

                <footer class="modal-actions">
                    @if (IsFreePlan(selectedPlan))
                    {
                        <a class="modal-primary-button" href="@GetRegistrationUrl(selectedPlan.Id)">Comenzar gratis</a>
                    }
                    else
                    {
                        <button class="modal-primary-button" type="button" disabled>Pago no disponible · Próximamente</button>
                    }
                    <button class="modal-secondary-button" type="button" @onclick="ClosePlanDetails">Volver</button>
                </footer>
            </section>
        </div>
    }
</div>

@code {
    private bool isAnnual;
    private readonly CancellationTokenSource cancellationTokenSource = new();
    private PlanDto? selectedPlan;
    private IReadOnlyList<PlanDto> plans = [];
    private IReadOnlyList<FaqDto> faqs = [];
    private IReadOnlyList<TestimonialDto> testimonials = [];
    private bool isPlansLoading = true;
    private bool isFaqLoading = true;
    private bool isTestimonialsLoading = true;
    private string? plansError;
    private string? faqError;
    private string? testimonialsError;

    private IReadOnlyList<TestimonialDto> VisibleTestimonials => testimonials
        .Where(item => !string.IsNullOrWhiteSpace(item.Name) && !string.IsNullOrWhiteSpace(item.Quote))
        .ToArray();

    private string BillingPeriod => isAnnual ? "año" : "mes";

    private string GetRegistrationUrl(string planId) =>
        $"/register?plan={Uri.EscapeDataString(planId)}&cycle={(isAnnual ? "yearly" : "monthly")}";

    private static bool IsFreePlan(PlanDto plan) =>
        plan.Id.Equals("free", StringComparison.OrdinalIgnoreCase) && plan.PriceMonthly == 0 && plan.PriceYearly == 0;

    protected override async Task OnInitializedAsync() =>
        await Task.WhenAll(LoadPlansAsync(), LoadFaqAsync(), LoadTestimonialsAsync());

    private string GetPrice(PlanDto plan) =>
        $"${(isAnnual ? plan.PriceYearly : plan.PriceMonthly).ToString("0.00", CultureInfo.InvariantCulture)}";

    private void OpenPlanDetails(PlanDto plan)
    {
        selectedPlan = plan;
    }

    private void ClosePlanDetails()
    {
        selectedPlan = null;
    }

    private async Task LoadPlansAsync()
    {
        isPlansLoading = true;
        plansError = null;
        selectedPlan = null;
        try
        {
            plans = await PlanService.GetPlansAsync(cancellationTokenSource.Token);
        }
        catch (ApiException exception)
        {
            plans = [];
            plansError = ApiErrorMessages.For(exception, "No pudimos cargar los planes.");
        }
        catch (OperationCanceledException) when (cancellationTokenSource.IsCancellationRequested)
        {
        }
        catch (Exception)
        {
            plans = [];
            plansError = "No pudimos cargar los planes. Inténtalo nuevamente.";
        }
        finally
        {
            isPlansLoading = false;
        }
    }

    private async Task LoadFaqAsync()
    {
        isFaqLoading = true;
        faqError = null;
        try
        {
            faqs = await ContentService.GetFaqAsync(cancellationTokenSource.Token);
        }
        catch (ApiException exception)
        {
            faqs = [];
            faqError = ApiErrorMessages.For(exception, "No pudimos cargar las preguntas frecuentes.");
        }
        catch (OperationCanceledException) when (cancellationTokenSource.IsCancellationRequested)
        {
        }
        catch (Exception)
        {
            faqs = [];
            faqError = "No pudimos cargar las preguntas frecuentes. Inténtalo nuevamente.";
        }
        finally
        {
            isFaqLoading = false;
        }
    }

    private async Task LoadTestimonialsAsync()
    {
        isTestimonialsLoading = true;
        testimonialsError = null;
        try
        {
            testimonials = await ContentService.GetTestimonialsAsync(cancellationTokenSource.Token);
        }
        catch (ApiException exception)
        {
            testimonials = [];
            testimonialsError = ApiErrorMessages.For(exception, "No pudimos cargar los testimonios.");
        }
        catch (OperationCanceledException) when (cancellationTokenSource.IsCancellationRequested)
        {
        }
        catch (Exception)
        {
            testimonials = [];
            testimonialsError = "No pudimos cargar los testimonios. Inténtalo nuevamente.";
        }
        finally
        {
            isTestimonialsLoading = false;
        }
    }

    private static string GetInitials(string name) => string.Concat(name
        .Split(' ', StringSplitOptions.RemoveEmptyEntries)
        .Take(2)
        .Select(part => char.ToUpperInvariant(part[0])));

    public void Dispose() => cancellationTokenSource.Cancel();
}
