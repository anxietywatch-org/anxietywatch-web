@page "/dashboard"
@layout DashboardLayout
@using System.Globalization
@using AnxietyWatch.Web.Client.Models.Api
@inject IEventService EventService
@inject IAuthSessionManager SessionManager
@inject NavigationManager Navigation

<PageTitle>Resumen | AnxietyWatch</PageTitle>

<section class="dashboard-page" aria-labelledby="dashboard-title">
    <header class="page-header">
        <div>
            <h1 id="dashboard-title">Bienvenido@(string.IsNullOrWhiteSpace(userName) ? string.Empty : $", {userName}")</h1>
            <p>Plan activo: @PlanName <span aria-hidden="true">·</span> Hoy es @CurrentDate.</p>
            @if (HasWearableIntegration)
            {
                <p class="wearable-note">Los registros del dispositivo vinculado llegan automáticamente.</p>
            }
        </div>
    </header>

    <section class="history-card" aria-labelledby="history-title">
        <header class="history-header">
            <div>
                <h2 id="history-title">Alertas por día</h2>
                <p>Consulta cuántas alertas del paciente ocurrieron cada día.</p>
            </div>
            <div class="range-selector" aria-label="Periodo del historial">
                @foreach (var range in Ranges)
                {
                    <button type="button"
                            class="@(selectedRange == range ? "is-active" : null)"
                            aria-pressed="@(selectedRange == range)"
                            disabled="@isChartLoading"
                            @onclick="() => ChangeRangeAsync(range)">@range días</button>
                }
            </div>
        </header>

        @if (isChartLoading)
        {
            <div class="chart-state" role="status">Cargando alertas...</div>
        }
        else if (!string.IsNullOrEmpty(chartError))
        {
            <div class="chart-state chart-state--error" role="alert">
                <span>@chartError</span>
                <button type="button" disabled="@isChartLoading" @onclick="LoadAlertPointsAsync">Reintentar</button>
            </div>
        }
        else if (!HasEventsInSelectedRange)
        {
            <div class="chart-state">
                <strong>Aún no hay alertas en este periodo.</strong>
                <span>@(HasWearableIntegration
                    ? "Las alertas del dispositivo aparecerán aquí cuando estén disponibles."
                    : "Aquí verás la evolución en cuanto haya alertas.")</span>
            </div>
        }
        else
        {
            <figure class="history-chart" aria-labelledby="history-title">
                <figcaption class="visually-hidden">Cantidad diaria de alertas durante los últimos @selectedRange días.</figcaption>
                <div class="chart-layout">
                    <div class="y-axis" aria-hidden="true">
                        @foreach (var value in YAxisValues)
                        {
                            <span>@FormatYAxisValue(value)</span>
                        }
                    </div>
                    <div class="chart-scroll">
                        <div class="chart-plot" style="--point-count: @Math.Max(dailyAlertPoints.Count, 7)">
                            <svg class="alert-line-chart" viewBox="0 0 100 100" preserveAspectRatio="none" role="img" aria-label="Línea de cantidad diaria de alertas">
                                <polyline class="alert-line" points="@AlertPolylinePoints" />
                                @for (var index = 0; index < dailyAlertPoints.Count; index++)
                                {
                                    var point = dailyAlertPoints[index];
                                    <circle class="alert-point" cx="@GetPointX(index)" cy="@GetPointY(point)" r="1.7" @key="point.Date">
                                        <title>@DailyAlertPointTitle(point)</title>
                                    </circle>
                                }
                            </svg>
                            <div class="x-axis" aria-hidden="true">
                                @foreach (var point in dailyAlertPoints)
                                {
                                    <span>@point.Date.ToString("dd/MM")</span>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </figure>
        }
    </section>
</section>

@code {
    private static readonly CultureInfo SpanishCulture = CultureInfo.GetCultureInfo("es-ES");
    private static readonly int[] Ranges = [7, 30, 90];
    private IReadOnlyList<AlertPointDto> allAlertEvents = [];
    private IReadOnlyList<DailyAlertPoint> dailyAlertPoints = [];
    private string? userName;
    private string? planId;
    private string? chartError;
    private int selectedRange = 7;
    private bool isChartLoading = true;
    private bool isRedirecting;

    private string CurrentDate => DateTime.Now.ToString("dddd, d 'de' MMMM 'de' yyyy", SpanishCulture);
    private string PlanName => planId?.ToLowerInvariant() switch
    {
        "free" => "Gratuito",
        "individual" => "Individual",
        "family" or "familiar" => "Familiar",
        "professional" or "profesional" => "Profesional",
        { Length: > 0 } value => value,
        _ => "Cargando..."
    };
    private bool HasWearableIntegration => planId?.Trim().ToLowerInvariant() is
        "individual" or "family" or "familiar" or "professional" or "profesional";
    private bool HasEventsInSelectedRange => dailyAlertPoints.Any(point => point.Count > 0);
    private int ChartMaximum => Math.Max(1, dailyAlertPoints.Max(point => point.Count));
    private double[] YAxisValues => [ChartMaximum, ChartMaximum * 0.75, ChartMaximum * 0.5, ChartMaximum * 0.25, 0];
    private string AlertPolylinePoints => string.Join(" ", dailyAlertPoints.Select((point, index) =>
        $"{GetPointX(index)},{GetPointY(point)}"));

    protected override async Task OnInitializedAsync()
    {
        LoadSession();
        if (!isRedirecting)
        {
            await LoadAlertPointsAsync();
        }
    }

    private void LoadSession()
    {
        var user = SessionManager.CurrentUser;
        if (user is null)
        {
            isRedirecting = true;
            Navigation.NavigateTo("/login", replace: true);
            return;
        }

        userName = user.FullName.Split(' ', StringSplitOptions.RemoveEmptyEntries).FirstOrDefault();
        planId = user.PlanId;
    }

    private async Task LoadAlertPointsAsync()
    {
        isChartLoading = true;
        chartError = null;
        try
        {
            allAlertEvents = (await EventService.GetEventsAsync(50)).OrderBy(point => point.OccurredAt).ToArray();
            BuildDailyAlertPoints();
        }
        catch (ApiException exception)
        {
            if (exception.StatusCode == 401) await RedirectToLoginAsync();
            else chartError = ApiErrorMessages.For(exception, "No pudimos cargar el historial de alertas.");
        }
        catch
        {
            chartError = "No pudimos cargar el historial de alertas. Inténtalo nuevamente.";
        }
        finally
        {
            isChartLoading = false;
        }
    }

    private Task ChangeRangeAsync(int range)
    {
        if (range == selectedRange || isChartLoading) return Task.CompletedTask;
        selectedRange = range;
        BuildDailyAlertPoints();
        return Task.CompletedTask;
    }

    private void BuildDailyAlertPoints()
    {
        var lastDate = DateOnly.FromDateTime(DateTime.Now);
        var firstDate = lastDate.AddDays(-(selectedRange - 1));
        var eventsByDate = allAlertEvents
            .Select(alertEvent => new
            {
                Event = alertEvent,
                Date = DateOnly.FromDateTime(alertEvent.OccurredAt.ToLocalTime().DateTime)
            })
            .Where(item => item.Date >= firstDate && item.Date <= lastDate)
            .GroupBy(item => item.Date)
            .ToDictionary(group => group.Key, group => group.Select(item => item.Event).ToArray());

        dailyAlertPoints = Enumerable.Range(0, selectedRange)
            .Select(offset =>
            {
                var date = firstDate.AddDays(offset);
                var events = eventsByDate.GetValueOrDefault(date, []);
                return new DailyAlertPoint(date, events.Length, GetAlertBreakdown(events));
            })
            .ToArray();
    }

    private async Task RedirectToLoginAsync()
    {
        if (isRedirecting) return;
        isRedirecting = true;
        await SessionManager.ClearAsync();
        Navigation.NavigateTo("/login", replace: true);
    }

    private string GetPointX(int index)
    {
        var value = dailyAlertPoints.Count <= 1 ? 50d : index * 100d / (dailyAlertPoints.Count - 1);
        return value.ToString("0.##", CultureInfo.InvariantCulture);
    }

    private string GetPointY(DailyAlertPoint point)
    {
        var value = 100 - point.Count * 100d / ChartMaximum;
        return value.ToString("0.##", CultureInfo.InvariantCulture);
    }

    private static string GetAlertBreakdown(IReadOnlyList<AlertPointDto> events) => string.Join(", ", events
        .GroupBy(GetAlertCategory)
        .OrderBy(group => group.Key)
        .Select(group => $"{group.Count()} {group.Key}"));

    private static string GetAlertCategory(AlertPointDto alertEvent)
    {
        if (alertEvent.Type.Equals("SOS", StringComparison.OrdinalIgnoreCase)) return "SOS";
        if (alertEvent.Status.Equals("SUPPORT_REQUESTED", StringComparison.OrdinalIgnoreCase)) return "apoyo solicitado";
        return alertEvent.Type.Replace('_', ' ').ToLowerInvariant();
    }

    private static string FormatYAxisValue(double value) =>
        value.ToString(value % 1 == 0 ? "0" : "0.##", CultureInfo.InvariantCulture);

    private static string DailyAlertPointTitle(DailyAlertPoint point)
    {
        var countLabel = point.Count == 1 ? "1 evento" : $"{point.Count} eventos";
        return string.IsNullOrEmpty(point.Breakdown)
            ? $"{point.Date.ToString("d 'de' MMMM", SpanishCulture)}: {countLabel}"
            : $"{point.Date.ToString("d 'de' MMMM", SpanishCulture)}: {countLabel} ({point.Breakdown})";
    }

    private sealed record DailyAlertPoint(DateOnly Date, int Count, string Breakdown);
}
