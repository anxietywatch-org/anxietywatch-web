@page "/dashboard"
@layout DashboardLayout
@using System.Globalization
@using AnxietyWatch.Web.Client.Models.Api
@inject IDashboardService DashboardService
@inject IEpisodeService EpisodeService
@inject IAuthSessionManager SessionManager
@inject NavigationManager Navigation

<PageTitle>Resumen | AnxietyWatch</PageTitle>

<section class="dashboard-page" aria-labelledby="dashboard-title">
    <header class="page-header">
        <div>
            <h1 id="dashboard-title">Bienvenido@(string.IsNullOrWhiteSpace(userName) ? string.Empty : $", {userName}")</h1>
            <p>Plan activo: @PlanName <span aria-hidden="true">·</span> Hoy es @CurrentDate.</p>
        </div>
        <a class="primary-action" href="/dashboard/episodes">
            <span aria-hidden="true">+</span> Registrar episodio
        </a>
    </header>

    @if (isSummaryLoading)
    {
        <div class="state-panel" role="status">Cargando tu resumen...</div>
    }
    else if (!string.IsNullOrEmpty(summaryError))
    {
        <div class="state-panel state-panel--error" role="alert">
            <span>@summaryError</span>
            <button type="button" disabled="@isSummaryLoading" @onclick="LoadSummaryAsync">Reintentar</button>
        </div>
    }
    else if (summary is not null)
    {
        <section class="kpi-grid" aria-label="Métricas principales">
            <article class="kpi-card">
                <div class="kpi-card__top">
                    <span class="kpi-icon kpi-icon--sage" aria-hidden="true">
                        <svg viewBox="0 0 24 24"><path d="M4 12h3l2-5 3.5 10 2.5-6 1.5 3H20" /></svg>
                    </span>
                    <span class="kpi-trend kpi-trend--@TrendCss" aria-label="@TrendLabel">@TrendIcon</span>
                </div>
                <strong class="kpi-value">@summary.AnxietyLevel.Current</strong>
                <div class="kpi-meta">
                    <strong>@AnxietyLabel(summary.AnxietyLevel.Current)</strong>
                    <span>Nivel de ansiedad</span>
                </div>
            </article>

            <article class="kpi-card">
                <div class="kpi-card__top">
                    <span class="kpi-icon kpi-icon--teal" aria-hidden="true">
                        <svg viewBox="0 0 24 24"><rect x="5" y="3" width="14" height="18" rx="3" /><path d="M9 8h6m-6 4h6m-6 4h4" /></svg>
                    </span>
                    <span class="kpi-trend kpi-trend--stable" aria-label="Sin tendencia disponible">−</span>
                </div>
                <strong class="kpi-value">@summary.WeeklyRecords.Used</strong>
                <div class="kpi-meta">
                    <strong>@WeeklyLimit</strong>
                    <span>Registros esta semana</span>
                </div>
            </article>

            <article class="kpi-card">
                <div class="kpi-card__top">
                    <span class="kpi-icon kpi-icon--mint" aria-hidden="true">
                        <svg viewBox="0 0 24 24"><path d="M13 3s1 4-2 6c-2-2-4-1-5 1-2 4 1 9 6 11 5-2 8-6 6-11-.8-2-2.7-3.4-5-7Z" /><path d="M9.5 15c0-1.8 1.1-3.2 2.5-4 1.4.8 2.5 2.2 2.5 4a2.5 2.5 0 0 1-5 0Z" /></svg>
                    </span>
                    <span class="kpi-trend kpi-trend--stable" aria-label="Sin tendencia disponible">−</span>
                </div>
                <strong class="kpi-value">@summary.StreakDays días</strong>
                <div class="kpi-meta">
                    <strong>@(summary.StreakDays > 0 ? "Sigue así" : "Comienza hoy")</strong>
                    <span>Racha actual</span>
                </div>
            </article>

            <article class="kpi-card">
                <div class="kpi-card__top">
                    <span class="kpi-icon kpi-icon--sand" aria-hidden="true">
                        <svg viewBox="0 0 24 24"><path d="M12 20c-4.5 0-7-2.4-8-6.8 3.8-.4 6.5 1 8 4.1 1.5-3.1 4.2-4.5 8-4.1-1 4.4-3.5 6.8-8 6.8Z" /><path d="M12 17.3C8.8 15 8.2 11.5 12 6c3.8 5.5 3.2 9-0 11.3ZM6.8 9.5c2.1.5 3.8 1.6 5.2 3.5 1.4-1.9 3.1-3 5.2-3.5" /></svg>
                    </span>
                    <span class="kpi-trend kpi-trend--stable" aria-label="Sin tendencia disponible">−</span>
                </div>
                <strong class="kpi-value">@summary.ExercisesCompleted</strong>
                <div class="kpi-meta">
                    <strong>Actividad acumulada</strong>
                    <span>Ejercicios completados</span>
                </div>
            </article>
        </section>
    }

    <section class="history-card" aria-labelledby="history-title">
        <header class="history-header">
            <div>
                <h2 id="history-title">Historial de ansiedad</h2>
                <p>Consulta la evolución de tus últimos registros.</p>
            </div>
            <div class="range-selector" aria-label="Periodo del historial">
                @foreach (var range in Ranges)
                {
                    <button type="button"
                            class="@(selectedRange == range ? "is-active" : null)"
                            aria-pressed="@(selectedRange == range)"
                            disabled="@isEpisodesLoading"
                            @onclick="() => ChangeRangeAsync(range)">@range días</button>
                }
            </div>
        </header>

        @if (isEpisodesLoading)
        {
            <div class="chart-state" role="status">Cargando episodios...</div>
        }
        else if (!string.IsNullOrEmpty(episodesError))
        {
            <div class="chart-state chart-state--error" role="alert">
                <span>@episodesError</span>
                <button type="button" disabled="@isEpisodesLoading" @onclick="LoadEpisodesAsync">Reintentar</button>
            </div>
        }
        else if (episodes.Count == 0)
        {
            <div class="chart-state">
                <strong>Aún no hay episodios en este periodo.</strong>
                <span>Registra cómo te sientes para empezar a ver tu evolución.</span>
                <a href="/dashboard/episodes">Registrar episodio</a>
            </div>
        }
        else
        {
            <figure class="history-chart" aria-labelledby="history-title">
                <figcaption class="visually-hidden">Intensidad de @episodes.Count episodios durante los últimos @selectedRange días.</figcaption>
                <div class="chart-layout">
                    <div class="y-axis" aria-hidden="true"><span>100</span><span>75</span><span>50</span><span>25</span><span>0</span></div>
                    <div class="chart-scroll">
                        <div class="chart-plot" style="--point-count: @Math.Max(episodes.Count, 7)">
                            <div class="chart-bars">
                                @foreach (var episode in episodes)
                                {
                                    <div class="chart-column" title="@EpisodeTitle(episode)" @key="episode.Id">
                                        <span class="chart-value">@episode.Intensity</span>
                                        <span class="chart-bar" style="height: @Math.Clamp(episode.Intensity, 0, 100)%"></span>
                                    </div>
                                }
                            </div>
                            <div class="x-axis" aria-hidden="true">
                                @foreach (var episode in episodes)
                                {
                                    <span>@episode.Date.ToLocalTime().ToString("dd/MM")</span>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </figure>
        }
    </section>
</section>

@code {
    private static readonly CultureInfo SpanishCulture = CultureInfo.GetCultureInfo("es-ES");
    private static readonly int[] Ranges = [7, 30, 90];
    private DashboardSummaryDto? summary;
    private IReadOnlyList<EpisodeDto> episodes = [];
    private string? userName;
    private string? planId;
    private string? summaryError;
    private string? episodesError;
    private int selectedRange = 7;
    private bool isSummaryLoading = true;
    private bool isEpisodesLoading = true;
    private bool isRedirecting;

    private string CurrentDate => DateTime.Now.ToString("dddd, d 'de' MMMM 'de' yyyy", SpanishCulture);
    private string PlanName => planId?.ToLowerInvariant() switch
    {
        "free" => "Gratuito",
        "individual" => "Individual",
        "family" or "familiar" => "Familiar",
        "professional" or "profesional" => "Profesional",
        { Length: > 0 } value => value,
        _ => "Cargando..."
    };
    private string WeeklyLimit => summary?.WeeklyRecords.Limit is int limit
        ? $"Límite semanal: {limit}"
        : "Sin límite semanal";
    private string NormalizedTrend => summary?.AnxietyLevel.Trend.Trim().ToLowerInvariant() ?? "stable";
    private string TrendIcon => NormalizedTrend switch { "up" => "↑", "down" => "↓", _ => "−" };
    private string TrendCss => NormalizedTrend switch { "up" => "up", "down" => "down", _ => "stable" };
    private string TrendLabel => NormalizedTrend switch
    {
        "up" => "Tendencia al alza",
        "down" => "Tendencia a la baja",
        _ => "Tendencia estable"
    };

    protected override async Task OnInitializedAsync()
    {
        LoadSession();
        if (!isRedirecting)
        {
            await Task.WhenAll(LoadSummaryAsync(), LoadEpisodesAsync());
        }
    }

    private void LoadSession()
    {
        var user = SessionManager.CurrentUser;
        if (user is null)
        {
            isRedirecting = true;
            Navigation.NavigateTo("/login", replace: true);
            return;
        }

        userName = user.FullName.Split(' ', StringSplitOptions.RemoveEmptyEntries).FirstOrDefault();
        planId = user.PlanId;
    }

    private async Task LoadSummaryAsync()
    {
        isSummaryLoading = true;
        summaryError = null;
        try
        {
            summary = await DashboardService.GetSummaryAsync();
        }
        catch (ApiException exception)
        {
            if (exception.StatusCode == 401) await RedirectToLoginAsync();
            else summaryError = ApiErrorMessages.For(exception, "No pudimos cargar tu resumen.");
        }
        catch
        {
            summaryError = "No pudimos cargar tu resumen. Inténtalo nuevamente.";
        }
        finally
        {
            isSummaryLoading = false;
        }
    }

    private async Task LoadEpisodesAsync()
    {
        isEpisodesLoading = true;
        episodesError = null;
        try
        {
            episodes = (await EpisodeService.GetEpisodesAsync(selectedRange)).OrderBy(episode => episode.Date).ToArray();
        }
        catch (ApiException exception)
        {
            if (exception.StatusCode == 401) await RedirectToLoginAsync();
            else episodesError = ApiErrorMessages.For(exception, "No pudimos cargar tus episodios.");
        }
        catch
        {
            episodesError = "No pudimos cargar tus episodios. Inténtalo nuevamente.";
        }
        finally
        {
            isEpisodesLoading = false;
        }
    }

    private async Task ChangeRangeAsync(int range)
    {
        if (range == selectedRange || isEpisodesLoading) return;
        selectedRange = range;
        await LoadEpisodesAsync();
    }

    private async Task RedirectToLoginAsync()
    {
        if (isRedirecting) return;
        isRedirecting = true;
        await SessionManager.ClearAsync();
        Navigation.NavigateTo("/login", replace: true);
    }

    private static string AnxietyLabel(int value) => value switch
    {
        <= 25 => "Bajo",
        <= 50 => "Moderado",
        <= 75 => "Alto",
        _ => "Muy alto"
    };

    private static string EpisodeTitle(EpisodeDto episode) =>
        $"{episode.Date.ToLocalTime().ToString("g", SpanishCulture)}: intensidad {episode.Intensity}";
}
