@page "/dashboard/help"
@using System.ComponentModel.DataAnnotations
@using AnxietyWatch.Web.Client.Models.Api
@layout DashboardLayout
@inject IContentService ContentService
@inject ISupportService SupportService
@inject IAuthSessionManager SessionManager
@inject NavigationManager Navigation
@implements IDisposable

<PageTitle>Centro de ayuda | AnxietyWatch</PageTitle>

<section class="help-page" aria-labelledby="help-title">
    <header class="help-header">
        <span>Soporte</span>
        <h1 id="help-title">Centro de ayuda</h1>
        <p>Consulta las respuestas disponibles o revisa las opciones de contacto.</p>
    </header>

    <div class="help-grid">
        <section class="faq-column" aria-labelledby="faq-title">
            <header class="section-heading">
                <div>
                    <h2 id="faq-title">Preguntas frecuentes</h2>
                    <p>Encuentra respuestas rápidas sobre AnxietyWatch.</p>
                </div>
                @if (!isLoading && string.IsNullOrWhiteSpace(errorMessage))
                {
                    <span>@filteredFaqs.Count resultados</span>
                }
            </header>

            <div class="input-icon-wrapper faq-search">
                <svg class="input-icon-element faq-search__icon" viewBox="0 0 24 24" aria-hidden="true">
                    <circle cx="11" cy="11" r="7" />
                    <path d="m16 16 5 5" />
                </svg>
                <input class="form-input input-with-padding"
                       type="search"
                       placeholder="Buscar pregunta..."
                       aria-label="Buscar pregunta frecuente"
                       disabled="@isLoading"
                       @bind="searchQuery"
                       @bind:event="oninput" />
            </div>

            <div class="faq-list" aria-busy="@isLoading">
                @if (isLoading)
                {
                    <div class="faq-empty" role="status">
                        <strong>Cargando preguntas frecuentes...</strong>
                    </div>
                }
                else if (!string.IsNullOrWhiteSpace(errorMessage))
                {
                    <div class="faq-empty" role="alert">
                        <strong>No pudimos cargar las preguntas</strong>
                        <p>@errorMessage</p>
                        <button type="button" @onclick="LoadFaqAsync">Reintentar</button>
                    </div>
                }
                else if (faqs.Count == 0)
                {
                    <div class="faq-empty" role="status">
                        <strong>No hay preguntas disponibles</strong>
                        <p>Vuelve a intentarlo más tarde.</p>
                    </div>
                }
                else if (filteredFaqs.Count == 0)
                {
                    <div class="faq-empty">
                        <strong>No encontramos resultados</strong>
                        <p>Prueba con otros términos de búsqueda.</p>
                    </div>
                }
                else
                {
                    @foreach (var faq in filteredFaqs)
                    {
                        <article class="faq-item @(openFaqId == faq.Id ? "is-open" : null)">
                            <button type="button"
                                    aria-expanded="@(openFaqId == faq.Id)"
                                    aria-controls="faq-answer-@faq.Id"
                                    @onclick="() => ToggleFaq(faq.Id)">
                                <span class="faq-question">@faq.Question</span>
                                <svg class="faq-chevron" viewBox="0 0 24 24" aria-hidden="true">
                                    <path d="m7 9 5 5 5-5" />
                                </svg>
                            </button>
                            @if (openFaqId == faq.Id)
                            {
                                <div class="faq-answer" id="faq-answer-@faq.Id">
                                    <p>@faq.Answer</p>
                                </div>
                            }
                        </article>
                    }
                }
            </div>
        </section>

        <aside class="ticket-column">
            <section class="ticket-card" aria-labelledby="ticket-title">
                <header class="ticket-card__header">
                    <span aria-hidden="true">
                        <svg viewBox="0 0 24 24">
                            <path d="M21 15a4 4 0 0 1-4 4H8l-5 3V7a4 4 0 0 1 4-4h10a4 4 0 0 1 4 4v8Z" />
                            <path d="M8 9h8m-8 4h5" />
                        </svg>
                    </span>
                    <div>
                        <h2 id="ticket-title">Contactar con soporte</h2>
                        <p>Cuéntanos cómo podemos ayudarte.</p>
                    </div>
                </header>

                @if (!string.IsNullOrWhiteSpace(ticketMessage))
                {
                    <div class="@(ticketMessageIsError ? "auth-alert" : "ticket-success")"
                         role="@(ticketMessageIsError ? "alert" : "status")">@ticketMessage</div>
                }

                <EditForm Model="ticketModel" OnValidSubmit="SubmitTicketAsync" class="ticket-form">
                    <DataAnnotationsValidator />

                    <div class="ticket-field">
                        <label for="ticket-subject">Asunto</label>
                        <InputText id="ticket-subject"
                                   class="form-input"
                                   placeholder="Describe brevemente tu problema"
                                   disabled="@isSubmittingTicket"
                                   @bind-Value="ticketModel.Subject" />
                        <ValidationMessage For="@(() => ticketModel.Subject)" />
                    </div>

                    <div class="ticket-form__row">
                        <div class="ticket-field">
                            <label for="ticket-category">Categoría</label>
                            <InputSelect id="ticket-category" class="form-input" disabled="@isSubmittingTicket" @bind-Value="ticketModel.Category">
                                <option value="general">General</option>
                                <option value="tokens">Tokens</option>
                                <option value="billing">Facturación</option>
                                <option value="technical">Error Técnico</option>
                            </InputSelect>
                        </div>

                        <div class="ticket-field">
                            <label for="ticket-priority">Prioridad</label>
                            <InputSelect id="ticket-priority" class="form-input" disabled="@isSubmittingTicket" @bind-Value="ticketModel.Priority">
                                <option value="low">Baja</option>
                                <option value="normal">Normal</option>
                                <option value="high">Alta</option>
                            </InputSelect>
                        </div>
                    </div>

                    <div class="ticket-field">
                        <label for="ticket-message">Mensaje</label>
                        <InputTextArea id="ticket-message"
                                       class="form-input ticket-message"
                                       rows="4"
                                       placeholder="Describe el problema con el mayor detalle posible..."
                                       disabled="@isSubmittingTicket"
                                       @bind-Value="ticketModel.Message" />
                        <ValidationMessage For="@(() => ticketModel.Message)" />
                    </div>

                    <button class="ticket-submit" type="submit" disabled="@isSubmittingTicket" aria-disabled="@isSubmittingTicket">
                        <svg viewBox="0 0 24 24" aria-hidden="true">
                            <path d="m3 11 18-8-8 18-2-8-8-2Z" />
                            <path d="m11 13 5-5" />
                        </svg>
                        @(isSubmittingTicket ? "Enviando..." : "Enviar ticket")
                    </button>
                </EditForm>
            </section>
        </aside>
    </div>
</section>

@code {
    private IReadOnlyList<FaqDto> faqs = [];
    private readonly CancellationTokenSource cancellationTokenSource = new();
    private TicketModel ticketModel = new();
    private string searchQuery = string.Empty;
    private int? openFaqId;
    private bool isLoading = true;
    private string? errorMessage;
    private bool isSubmittingTicket;
    private string? ticketMessage;
    private bool ticketMessageIsError;

    private IReadOnlyList<FaqView> filteredFaqs => faqs
        .Select((faq, index) => new FaqView(index, faq.Question, faq.Answer))
        .Where(faq => string.IsNullOrWhiteSpace(searchQuery) ||
            faq.Question.Contains(searchQuery, StringComparison.OrdinalIgnoreCase) ||
            faq.Answer.Contains(searchQuery, StringComparison.OrdinalIgnoreCase))
        .ToArray();

    protected override Task OnInitializedAsync() => LoadFaqAsync();

    private async Task LoadFaqAsync()
    {
        isLoading = true;
        errorMessage = null;
        openFaqId = null;
        try
        {
            faqs = await ContentService.GetFaqAsync(cancellationTokenSource.Token);
        }
        catch (ApiException exception)
        {
            faqs = [];
            errorMessage = ApiErrorMessages.For(exception, "No pudimos cargar las preguntas frecuentes.");
        }
        catch (OperationCanceledException) when (cancellationTokenSource.IsCancellationRequested)
        {
        }
        catch (Exception)
        {
            faqs = [];
            errorMessage = "No pudimos cargar las preguntas frecuentes. Inténtalo nuevamente.";
        }
        finally
        {
            isLoading = false;
        }
    }

    private void ToggleFaq(int faqId) => openFaqId = openFaqId == faqId ? null : faqId;

    private async Task SubmitTicketAsync()
    {
        if (isSubmittingTicket) return;
        isSubmittingTicket = true;
        ticketMessage = null;
        ticketMessageIsError = false;
        try
        {
            var created = await SupportService.CreateTicketAsync(
                new CreateSupportTicketRequest(
                    ticketModel.Subject,
                    ticketModel.Category,
                    ticketModel.Priority,
                    ticketModel.Message),
                cancellationTokenSource.Token);
            ticketMessage = $"Ticket enviado correctamente. Folio: {created.Id:D}.";
            ticketModel = new TicketModel();
        }
        catch (ApiException exception) when (exception.StatusCode == 401)
        {
            await SessionManager.ClearAsync();
            Navigation.NavigateTo("/login", replace: true);
        }
        catch (OperationCanceledException) when (cancellationTokenSource.IsCancellationRequested)
        {
        }
        catch (ApiException exception)
        {
            ticketMessageIsError = true;
            ticketMessage = ApiErrorMessages.For(exception, "No pudimos enviar el ticket.");
        }
        catch (Exception)
        {
            ticketMessageIsError = true;
            ticketMessage = "No pudimos enviar el ticket. Inténtalo nuevamente.";
        }
        finally
        {
            isSubmittingTicket = false;
        }
    }

    private sealed record FaqView(int Id, string Question, string Answer);

    public sealed class TicketModel
    {
        [Required(ErrorMessage = "El asunto es obligatorio.")]
        [StringLength(120, MinimumLength = 3, ErrorMessage = "El asunto debe tener entre 3 y 120 caracteres.")]
        public string Subject { get; set; } = string.Empty;

        public string Category { get; set; } = "general";

        public string Priority { get; set; } = "normal";

        [Required(ErrorMessage = "El mensaje es obligatorio.")]
        [StringLength(4000, MinimumLength = 10, ErrorMessage = "El mensaje debe tener entre 10 y 4000 caracteres.")]
        public string Message { get; set; } = string.Empty;
    }

    public void Dispose() => cancellationTokenSource.Cancel();
}
