@page "/dashboard/episodes"
@layout DashboardLayout
@using System.ComponentModel.DataAnnotations
@using System.Globalization
@using AnxietyWatch.Web.Client.Models.Api
@inject IEpisodeService EpisodeService
@inject IAuthSessionManager SessionManager
@inject NavigationManager Navigation

<PageTitle>Episodios | AnxietyWatch</PageTitle>

<section class="episodes-page" aria-labelledby="episodes-title">
    <header class="page-header">
        <div>
            <span class="eyebrow">Seguimiento</span>
            <h1 id="episodes-title">Episodios de ansiedad</h1>
            <p>Registra lo que sientes y revisa tu historial reciente.</p>
        </div>
        <a href="/dashboard">Volver al resumen</a>
    </header>

    <div class="episodes-layout">
        <section class="create-card" aria-labelledby="create-title">
            <header>
                <span class="card-icon" aria-hidden="true">+</span>
                <div>
                    <h2 id="create-title">Nuevo episodio</h2>
                    <p>Completa los detalles del momento actual.</p>
                </div>
            </header>

            <EditForm Model="form" OnValidSubmit="CreateEpisodeAsync">
                <DataAnnotationsValidator />
                <div class="form-field">
                    <label for="episode-intensity">Intensidad <span>@form.Intensity/100</span></label>
                    <InputNumber id="episode-intensity" class="form-input" min="0" max="100" @bind-Value="form.Intensity" disabled="@IsBusy" />
                    <ValidationMessage For="@(() => form.Intensity)" />
                </div>
                <div class="form-field">
                    <label for="episode-symptoms">Síntomas</label>
                    <InputText id="episode-symptoms" class="form-input" placeholder="Ej. palpitaciones, mareo, tensión" @bind-Value="form.Symptoms" disabled="@IsBusy" />
                    <small>Separa varios síntomas con comas.</small>
                    <ValidationMessage For="@(() => form.Symptoms)" />
                </div>
                <div class="form-field">
                    <label for="episode-notes">Notas <span>@form.Notes.Length/500</span></label>
                    <InputTextArea id="episode-notes" class="form-input form-textarea" maxlength="500" placeholder="Contexto opcional del episodio" @bind-Value="form.Notes" disabled="@IsBusy" />
                    <ValidationMessage For="@(() => form.Notes)" />
                </div>

                @if (!string.IsNullOrEmpty(createError))
                {
                    <div class="notice notice--error" role="alert">@createError</div>
                }
                @if (!string.IsNullOrEmpty(successMessage))
                {
                    <div class="notice notice--success" role="status">@successMessage</div>
                }

                <button class="submit-button" type="submit" disabled="@IsBusy">
                    @(isCreating ? "Guardando..." : "Guardar episodio")
                </button>
            </EditForm>
        </section>

        <section class="history-card" aria-labelledby="episode-history-title">
            <header class="history-header">
                <div>
                    <h2 id="episode-history-title">Tu historial</h2>
                    <p>Episodios registrados en el periodo seleccionado.</p>
                </div>
                <div class="range-selector" aria-label="Periodo del historial">
                    @foreach (var range in Ranges)
                    {
                        <button type="button" class="@(selectedRange == range ? "is-active" : null)" aria-pressed="@(selectedRange == range)" disabled="@IsBusy" @onclick="() => ChangeRangeAsync(range)">@range días</button>
                    }
                </div>
            </header>

            @if (isLoading)
            {
                <div class="list-state" role="status">Cargando episodios...</div>
            }
            else if (!string.IsNullOrEmpty(loadError))
            {
                <div class="list-state list-state--error" role="alert">
                    <span>@loadError</span>
                    <button type="button" disabled="@IsBusy" @onclick="LoadEpisodesAsync">Reintentar</button>
                </div>
            }
            else if (episodes.Count == 0)
            {
                <div class="list-state">
                    <strong>No hay episodios en los últimos @selectedRange días.</strong>
                    <span>Tu próximo registro aparecerá aquí.</span>
                </div>
            }
            else
            {
                <ol class="episode-list">
                    @foreach (var episode in episodes)
                    {
                        <li @key="episode.Id">
                            <div class="intensity" style="--intensity: @Math.Clamp(episode.Intensity, 0, 100)">
                                <strong>@episode.Intensity</strong><span>/100</span>
                            </div>
                            <div class="episode-content">
                                <div class="episode-heading">
                                    <time datetime="@episode.Date.ToString("O")">@FormatDate(episode.Date)</time>
                                    <span class="level level--@LevelCss(episode.Intensity)">@LevelLabel(episode.Intensity)</span>
                                </div>
                                @if (episode.Symptoms.Count > 0)
                                {
                                    <ul class="symptoms" aria-label="Síntomas">
                                        @foreach (var symptom in episode.Symptoms)
                                        {
                                            <li>@symptom</li>
                                        }
                                    </ul>
                                }
                                @if (!string.IsNullOrWhiteSpace(episode.Notes))
                                {
                                    <p>@episode.Notes</p>
                                }
                            </div>
                        </li>
                    }
                </ol>
            }
        </section>
    </div>
</section>

@code {
    private static readonly int[] Ranges = [7, 30, 90];
    private static readonly CultureInfo SpanishCulture = CultureInfo.GetCultureInfo("es-ES");
    private readonly EpisodeForm form = new();
    private IReadOnlyList<EpisodeDto> episodes = [];
    private int selectedRange = 7;
    private bool isLoading = true;
    private bool isCreating;
    private bool isRedirecting;
    private string? loadError;
    private string? createError;
    private string? successMessage;
    private bool IsBusy => isLoading || isCreating;

    protected override async Task OnInitializedAsync()
    {
        if (!SessionManager.IsAuthenticated)
        {
            await RedirectToLoginAsync();
            return;
        }

        await LoadEpisodesAsync();
    }

    private async Task LoadEpisodesAsync()
    {
        isLoading = true;
        loadError = null;
        try
        {
            episodes = (await EpisodeService.GetEpisodesAsync(selectedRange)).OrderByDescending(episode => episode.Date).ToArray();
        }
        catch (ApiException exception)
        {
            if (exception.StatusCode == 401) await RedirectToLoginAsync();
            else loadError = ApiErrorMessages.For(exception, "No pudimos cargar tus episodios.");
        }
        catch
        {
            loadError = "No pudimos cargar tus episodios. Inténtalo nuevamente.";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task ChangeRangeAsync(int range)
    {
        if (range == selectedRange || IsBusy) return;
        selectedRange = range;
        await LoadEpisodesAsync();
    }

    private async Task CreateEpisodeAsync()
    {
        if (IsBusy) return;
        isCreating = true;
        createError = null;
        successMessage = null;
        try
        {
            var symptoms = form.Symptoms
                .Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .ToArray();
            var request = new CreateEpisodeRequest
            {
                Intensity = form.Intensity,
                Symptoms = symptoms,
                Notes = string.IsNullOrWhiteSpace(form.Notes) ? null : form.Notes.Trim()
            };

            await EpisodeService.CreateEpisodeAsync(request);
            form.Reset();
            successMessage = "Episodio guardado correctamente.";
            isCreating = false;
            await LoadEpisodesAsync();
        }
        catch (ApiException exception)
        {
            if (exception.StatusCode == 401) await RedirectToLoginAsync();
            else createError = ApiErrorMessages.For(exception, "No pudimos guardar el episodio.");
        }
        catch
        {
            createError = "No pudimos guardar el episodio. Inténtalo nuevamente.";
        }
        finally
        {
            isCreating = false;
        }
    }

    private async Task RedirectToLoginAsync()
    {
        if (isRedirecting) return;
        isRedirecting = true;
        await SessionManager.ClearAsync();
        Navigation.NavigateTo("/login", replace: true);
    }

    private static string FormatDate(DateTimeOffset date) =>
        date.ToLocalTime().ToString("dddd, d 'de' MMMM · HH:mm", SpanishCulture);
    private static string LevelLabel(int value) => value switch { <= 25 => "Bajo", <= 50 => "Moderado", <= 75 => "Alto", _ => "Muy alto" };
    private static string LevelCss(int value) => value switch { <= 25 => "low", <= 50 => "medium", <= 75 => "high", _ => "very-high" };

    private sealed class EpisodeForm
    {
        [Range(0, 100, ErrorMessage = "La intensidad debe estar entre 0 y 100.")]
        public int Intensity { get; set; } = 50;

        [StringLength(500, ErrorMessage = "Los síntomas no pueden superar los 500 caracteres.")]
        public string Symptoms { get; set; } = string.Empty;

        [StringLength(500, ErrorMessage = "Las notas no pueden superar los 500 caracteres.")]
        public string Notes { get; set; } = string.Empty;

        public void Reset()
        {
            Intensity = 50;
            Symptoms = string.Empty;
            Notes = string.Empty;
        }
    }
}
