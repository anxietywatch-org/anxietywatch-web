@page "/dashboard/billing"
@using System.Globalization
@using AnxietyWatch.Web.Client.Models.Api
@layout DashboardLayout
@inject IPlanService PlanService
@inject IAuthSessionManager SessionManager
@inject NavigationManager Navigation

<PageTitle>Facturación | AnxietyWatch</PageTitle>

<section class="billing-page" aria-labelledby="billing-title">
    <header class="billing-header">
        <span>Cuenta</span>
        <h1 id="billing-title">Facturación</h1>
        <p>Consulta la información disponible de tu plan.</p>
    </header>

    @if (isLoading)
    {
        <div class="billing-state" role="status">Cargando información del plan...</div>
    }
    else if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="billing-state billing-state--error" role="alert">
            <p>@errorMessage</p>
            <button class="outline-button" type="button" @onclick="LoadPlanAsync" disabled="@isLoading">Reintentar</button>
        </div>
    }
    else
    {
        <article class="billing-overview billing-overview--single">
            <section class="plan-summary" aria-labelledby="active-plan-title">
                <div class="summary-heading">
                    <div>
                        <span class="summary-label">Plan activo</span>
                        <div class="plan-title-row">
                            <h2 id="active-plan-title">@(currentPlan?.Name ?? PlanName)</h2>
                            <span class="active-badge">Activo</span>
                        </div>
                    </div>
                    <a class="outline-button" href="/dashboard/plan">Ver planes</a>
                </div>

                @if (currentPlan is not null)
                {
                    <div class="plan-price">
                        <strong>@FormatPrice(currentPlan.PriceMonthly)</strong><span>/mes</span>
                    </div>
                    <ul class="billing-plan-features">
                        @foreach (var feature in currentPlan.Features)
                        {
                            <li>@feature</li>
                        }
                    </ul>
                }
            </section>
        </article>

        <section class="invoice-card billing-unavailable" aria-labelledby="billing-unavailable-title">
            <span class="billing-unavailable__icon" aria-hidden="true">
                <svg viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="14" rx="3" /><path d="M3 9h18M7 15h4" /></svg>
            </span>
            <div>
                <h2 id="billing-unavailable-title">Pagos y facturas aún no disponibles</h2>
                <p>La API actual no ofrece métodos de pago, renovaciones ni historial de facturas. No se muestran datos simulados y no se almacenan tarjetas en el navegador.</p>
            </div>
            <a class="outline-button" href="/dashboard/help">Contactar con soporte</a>
        </section>
    }
</section>

@code {
    private PlanDto? currentPlan;
    private string planId = string.Empty;
    private string? errorMessage;
    private bool isLoading = true;

    private string PlanName => planId.ToLowerInvariant() switch
    {
        "free" => "Gratuito",
        "individual" => "Individual",
        "family" => "Familiar",
        "professional" => "Profesional",
        _ => "Sin asignar"
    };

    protected override async Task OnInitializedAsync()
    {
        var user = SessionManager.CurrentUser;
        if (user is null)
        {
            await SessionManager.ClearAsync();
            Navigation.NavigateTo("/login", replace: true);
            return;
        }

        planId = user.PlanId;
        await LoadPlanAsync();
    }

    private async Task LoadPlanAsync()
    {
        isLoading = true;
        errorMessage = null;
        try
        {
            var plans = await PlanService.GetPlansAsync();
            currentPlan = plans.FirstOrDefault(plan =>
                string.Equals(plan.Id, planId, StringComparison.OrdinalIgnoreCase));
        }
        catch (ApiException exception) when (exception.StatusCode == 401)
        {
            await SessionManager.ClearAsync();
            Navigation.NavigateTo("/login", replace: true);
        }
        catch (ApiException exception)
        {
            errorMessage = ApiErrorMessages.For(exception, "No pudimos cargar la información del plan.");
        }
        catch
        {
            errorMessage = "No pudimos cargar la información del plan. Inténtalo nuevamente.";
        }
        finally
        {
            isLoading = false;
        }
    }

    private static string FormatPrice(decimal price) =>
        $"${price.ToString("0.00", CultureInfo.InvariantCulture)}";
}
