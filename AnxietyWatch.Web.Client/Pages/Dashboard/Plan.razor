@page "/dashboard/plan"
@layout DashboardLayout
@using System.Globalization
@using AnxietyWatch.Web.Client.Models.Api
@inject IPlanService PlanService
@inject IBillingService BillingService
@inject IAuthSessionManager SessionManager
@inject NavigationManager Navigation
@implements IDisposable

<PageTitle>Mi plan | AnxietyWatch</PageTitle>

<section class="plan-page" aria-labelledby="plan-page-title">
    <header class="page-header">
        <h1 id="plan-page-title">Mi plan</h1>
    </header>

    @if (isLoading)
    {
        <p role="status" aria-live="polite">Cargando tu plan...</p>
    }
    else if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div role="alert">
            <p>@errorMessage</p>
            <button class="plan-action plan-action--dark" type="button" @onclick="LoadPlansAsync">Reintentar</button>
        </div>
    }
    else if (plans.Count == 0)
    {
        <div role="status">
            <p>No hay planes disponibles por el momento.</p>
            <button class="plan-action plan-action--dark" type="button" @onclick="LoadPlansAsync">Reintentar</button>
        </div>
    }
    else
    {
        @if (currentPlan is not null)
        {
            <article class="current-plan-card" aria-labelledby="current-plan-title">
                <div class="current-plan-content">
                    <span class="active-plan-badge">Plan activo · @currentPlan.Name</span>

                    <div class="current-plan-heading">
                        <h2 id="current-plan-title">@currentPlan.Name</h2>
                        <div class="current-plan-price">
                            <strong>@FormatPrice(currentPlan.PriceMonthly)</strong>
                            <span>/mes</span>
                        </div>
                        <p>@currentPlan.IdealFor</p>
                    </div>

                    <ul class="benefits-grid" aria-label="Beneficios del plan @currentPlan.Name">
                        @foreach (var feature in currentPlan.Features)
                        {
                            <li><span aria-hidden="true">✓</span>@feature</li>
                        }
                    </ul>
                </div>

                <div class="current-plan-visual" aria-hidden="true">
                    <svg viewBox="0 0 24 24">
                        <circle cx="9" cy="8" r="3" />
                        <circle cx="17" cy="9" r="2" />
                        <path d="M3.5 20c.4-4.3 2.2-6.5 5.5-6.5s5.1 2.2 5.5 6.5m.5-5.5c2.9 0 4.6 1.8 5 5.5" />
                    </svg>
                </div>
            </article>
        }
        else
        {
            <p role="alert">No pudimos identificar tu plan actual en el catálogo disponible.</p>
        }

        <section class="change-plan-section" aria-labelledby="change-plan-title">
            <header class="section-header">
                <h2 id="change-plan-title">Planes disponibles</h2>
                <p>Compara beneficios y cambia de plan con un pago simulado seguro.</p>
            </header>

            <div class="plans-grid">
                @foreach (var plan in plans)
                {
                    <article class="option-card option-card--@plan.Id">
                        <header class="option-card__header">
                            <h3>@plan.Name</h3>
                            @if (plan.Id == currentPlanId)
                            {
                                <span class="change-badge change-badge--upgrade">Actual</span>
                            }
                        </header>
                        <div class="option-price">
                            <strong>@FormatPrice(plan.PriceMonthly)</strong>
                            <span>/mes</span>
                        </div>
                        <p>@plan.IdealFor</p>
                        <button class="plan-action plan-action--dark"
                                type="button"
                                disabled="@(plan.Id == currentPlanId)"
                                aria-label="Solicitar información para cambiar al plan @plan.Name"
                                @onclick="() => OpenPlanModal(plan)">
                            @(plan.Id == currentPlanId ? "Plan actual" : $"Elegir {plan.Name}")
                        </button>
                    </article>
                }
            </div>
        </section>
    }

    @if (selectedPlanChange is not null)
    {
        <div class="upgrade-overlay" role="presentation" @onclick="ClosePlanModal">
            <section class="upgrade-modal upgrade-modal--@selectedPlanChange.Id"
                     role="dialog"
                     aria-modal="true"
                     aria-labelledby="upgrade-modal-title"
                     @onclick:stopPropagation="true">
                <header class="upgrade-modal__header">
                    <h2 id="upgrade-modal-title">Cambiar a @selectedPlanChange.Name</h2>
                    <button class="upgrade-modal__close"
                            type="button"
                            aria-label="Cerrar aviso"
                            @onclick="ClosePlanModal">×</button>
                </header>

                @if (IsFreePlan(selectedPlanChange))
                {
                    <section class="upgrade-benefits" aria-labelledby="upgrade-benefits-title">
                        <h3 id="upgrade-benefits-title">Vas a cambiar a Gratuito</h3>
                        <p>No se te cobrará nada. Perderás el acceso a las funciones exclusivas de tu plan actual de inmediato.</p>
                        @if (!string.IsNullOrWhiteSpace(changePlanMessage))
                        {
                            <p role="@(changePlanSucceeded ? "status" : "alert")">@changePlanMessage</p>
                        }
                    </section>

                    <footer class="upgrade-modal__actions">
                        <button class="upgrade-button upgrade-button--cancel" type="button" @onclick="ClosePlanModal" disabled="@isChangingPlan">Volver</button>
                        <button class="upgrade-button upgrade-button--confirm" type="button" @onclick="ConfirmFreeDowngradeAsync" disabled="@isChangingPlan">@(isChangingPlan ? "Procesando..." : "Confirmar cambio")</button>
                    </footer>
                }
                else
                {
                    <div class="plan-comparison" aria-label="Comparación de planes">
                        @if (currentPlan is not null)
                        {
                            <article class="comparison-card comparison-card--current">
                                <span class="comparison-label">Plan actual</span>
                                <strong class="comparison-badge comparison-badge--current">@currentPlan.Name</strong>
                                <p><strong>@FormatPrice(GetPlanPrice(currentPlan))</strong><span>/@BillingCycleLabel</span></p>
                            </article>

                            <span class="comparison-arrow" aria-hidden="true">→</span>
                        }

                        <article class="comparison-card comparison-card--new">
                            <span class="comparison-label comparison-label--accent">Plan consultado</span>
                            <strong class="comparison-badge comparison-badge--new">@selectedPlanChange.Name</strong>
                            <p><strong>@FormatPrice(SelectedPlanPrice)</strong><span>/@BillingCycleLabel</span></p>
                        </article>
                    </div>

                    <section class="upgrade-benefits" aria-labelledby="upgrade-benefits-title">
                        <h3 id="upgrade-benefits-title">Resumen de tu compra</h3>
                        <ul class="modal-benefits">
                            @foreach (var feature in selectedPlanChange.Features)
                            {
                                <li><span aria-hidden="true">✓</span>@feature</li>
                            }
                        </ul>
                        <label for="billing-cycle">Ciclo de facturación</label>
                        <select id="billing-cycle" @bind="billingCycle" disabled="@isChangingPlan">
                            <option value="monthly">Mensual</option>
                            <option value="yearly">Anual</option>
                        </select>
                        <div class="checkout-total" aria-live="polite">
                            <span>Total de hoy</span>
                            <strong>@FormatPrice(SelectedPlanPrice) MXN</strong>
                            <small>@(billingCycle == "yearly" ? "Cobertura de 12 meses" : "Cobro mensual simulado")</small>
                        </div>
                        <div class="payment-methods" aria-label="Métodos de pago disponibles">
                            <span class="payment-method payment-method--visa">VISA</span>
                            <span class="payment-method payment-method--mastercard">●● Mastercard</span>
                            <span class="payment-method payment-method--paypal">PayPal</span>
                            <span class="payment-method payment-method--kueski">Kueski</span>
                        </div>
                        <div class="payment-fields">
                            <label for="plan-card-number">Número de tarjeta de prueba</label>
                            <input id="plan-card-number" type="text" inputmode="numeric" autocomplete="off" maxlength="19"
                                   placeholder="4242 4242 4242 4242" value="@demoCardNumber" @oninput="HandleCardNumberInput"
                                   aria-invalid="@(ShowCardError ? "true" : "false")" disabled="@isChangingPlan" />
                            @if (!string.IsNullOrWhiteSpace(DetectedCardBrand))
                            {
                                <small class="detected-brand">Detectada: @DetectedCardBrand</small>
                            }
                            @if (ShowCardError)
                            {
                                <small class="payment-field-error" role="alert">@CardError</small>
                            }
                            <div class="payment-field-row">
                                <div>
                                    <label for="plan-card-expiry">Vencimiento</label>
                                    <input id="plan-card-expiry" type="text" inputmode="numeric" autocomplete="off" maxlength="5"
                                           placeholder="MM/AA" value="@demoExpiry" @oninput="HandleExpiryInput"
                                           aria-invalid="@(ShowExpiryError ? "true" : "false")" disabled="@isChangingPlan" />
                                    @if (ShowExpiryError)
                                    {
                                        <small class="payment-field-error" role="alert">@ExpiryError</small>
                                    }
                                </div>
                                <div>
                                    <label for="plan-card-cvv">CVV</label>
                                    <input id="plan-card-cvv" type="password" inputmode="numeric" autocomplete="off" maxlength="4"
                                           placeholder="123" value="@demoCvv" @oninput="HandleCvvInput"
                                           aria-invalid="@(ShowCvvError ? "true" : "false")" disabled="@isChangingPlan" />
                                    @if (ShowCvvError)
                                    {
                                        <small class="payment-field-error" role="alert">@CvvError</small>
                                    }
                                </div>
                            </div>
                        </div>
                        <p class="checkout-security">Pago de demostración: estos datos solo viven en memoria y nunca se envían ni se guardan.</p>
                        @if (!string.IsNullOrWhiteSpace(changePlanMessage))
                        {
                            <p role="@(changePlanSucceeded ? "status" : "alert")">@changePlanMessage</p>
                        }
                    </section>

                    <footer class="upgrade-modal__actions">
                        <button class="upgrade-button upgrade-button--cancel" type="button" @onclick="ClosePlanModal" disabled="@isChangingPlan">Volver</button>
                        <button class="upgrade-button upgrade-button--confirm" type="button" @onclick="SimulatePaymentAsync" disabled="@isChangingPlan">@(isChangingPlan ? "Procesando..." : "Confirmar pago simulado")</button>
                    </footer>
                }
            </section>
        </div>
    }
</section>

@code {
    private IReadOnlyList<PlanDto> plans = [];
    private readonly CancellationTokenSource cancellationTokenSource = new();
    private PlanDto? currentPlan;
    private PlanDto? selectedPlanChange;
    private string? currentPlanId;
    private string? errorMessage;
    private bool isLoading = true;
    private bool isChangingPlan;
    private bool changePlanSucceeded;
    private string billingCycle = "monthly";
    private string? changePlanMessage;
    private string demoCardNumber = string.Empty;
    private string demoExpiry = string.Empty;
    private string demoCvv = string.Empty;
    private bool validationAttempted;
    private bool cardHadInvalidCharacters;
    private bool expiryHadInvalidCharacters;
    private bool cvvHadInvalidCharacters;

    private string BillingCycleLabel => billingCycle == "yearly" ? "año" : "mes";
    private decimal SelectedPlanPrice => selectedPlanChange is null ? 0 : GetPlanPrice(selectedPlanChange);
    private string DetectedCardBrand => DetectCardBrand(demoCardNumber);
    private string CardDigits => new(demoCardNumber.Where(char.IsDigit).ToArray());
    private string CardError => cardHadInvalidCharacters
        ? "El número de tarjeta solo puede contener dígitos."
        : CardDigits.Length < 13
            ? "Introduce al menos 13 dígitos."
            : !PassesLuhn(CardDigits) ? "El número de tarjeta de prueba no es válido." : string.Empty;
    private string ExpiryError => expiryHadInvalidCharacters
        ? "La fecha solo puede contener números."
        : !IsExpiryValid() ? "Introduce una fecha válida en formato MM/AA." : string.Empty;
    private string CvvError => cvvHadInvalidCharacters
        ? "El CVV solo puede contener números."
        : demoCvv.Length is not (3 or 4) ? "El CVV debe tener 3 o 4 dígitos." : string.Empty;
    private bool ShowCardError => (validationAttempted || cardHadInvalidCharacters) && !string.IsNullOrEmpty(CardError);
    private bool ShowExpiryError => (validationAttempted || expiryHadInvalidCharacters) && !string.IsNullOrEmpty(ExpiryError);
    private bool ShowCvvError => (validationAttempted || cvvHadInvalidCharacters) && !string.IsNullOrEmpty(CvvError);

    protected override async Task OnInitializedAsync()
    {
        currentPlanId = SessionManager.CurrentUser?.PlanId;
        await LoadPlansAsync();
    }

    private async Task LoadPlansAsync()
    {
        isLoading = true;
        errorMessage = null;
        selectedPlanChange = null;
        try
        {
            plans = await PlanService.GetPlansAsync(cancellationTokenSource.Token);
            currentPlanId = SessionManager.CurrentUser?.PlanId;
            currentPlan = plans.FirstOrDefault(plan => plan.Id == currentPlanId);
        }
        catch (ApiException exception) when (exception.StatusCode == 401)
        {
            errorMessage = ApiErrorMessages.For(exception);
            await SessionManager.ClearAsync();
            Navigation.NavigateTo("/login", replace: true);
        }
        catch (OperationCanceledException) when (cancellationTokenSource.IsCancellationRequested)
        {
        }
        catch (ApiException exception)
        {
            plans = [];
            currentPlan = null;
            errorMessage = ApiErrorMessages.For(exception, "No pudimos cargar los planes.");
        }
        catch (Exception)
        {
            plans = [];
            currentPlan = null;
            errorMessage = "No pudimos cargar los planes. Inténtalo nuevamente.";
        }
        finally
        {
            isLoading = false;
        }
    }

    private static string FormatPrice(decimal price) =>
        $"${price.ToString("0.00", CultureInfo.InvariantCulture)}";

    private static bool IsFreePlan(PlanDto plan) =>
        plan.Id.Equals("free", StringComparison.OrdinalIgnoreCase) && plan.PriceMonthly == 0 && plan.PriceYearly == 0;

    private void OpenPlanModal(PlanDto plan)
    {
        selectedPlanChange = plan;
        billingCycle = "monthly";
        changePlanMessage = null;
        changePlanSucceeded = false;
        demoCardNumber = string.Empty;
        demoExpiry = string.Empty;
        demoCvv = string.Empty;
        validationAttempted = false;
        cardHadInvalidCharacters = false;
        expiryHadInvalidCharacters = false;
        cvvHadInvalidCharacters = false;
    }

    private void ClosePlanModal() => selectedPlanChange = null;

    private async Task SimulatePaymentAsync()
    {
        if (selectedPlanChange is null || isChangingPlan) return;
        validationAttempted = true;
        if (!IsDemoPaymentValid())
        {
            changePlanMessage = "Revisa los campos marcados antes de confirmar el pago.";
            return;
        }
        isChangingPlan = true;
        changePlanMessage = null;
        changePlanSucceeded = false;
        try
        {
            await BillingService.SimulatePaymentAsync(
                new SimulatePaymentRequest(selectedPlanChange.Id, billingCycle));
            await SessionManager.RefreshSessionAsync();
            changePlanSucceeded = true;
            changePlanMessage = "Pago simulado registrado y plan actualizado.";
            await LoadPlansAsync();
        }
        catch (ApiException exception) when (exception.StatusCode == 401)
        {
            await SessionManager.ClearAsync();
            Navigation.NavigateTo("/login", replace: true);
        }
        catch (ApiException exception)
        {
            changePlanMessage = ApiErrorMessages.For(exception, "No pudimos actualizar el plan.");
        }
        catch
        {
            changePlanMessage = "No pudimos actualizar el plan. Inténtalo nuevamente.";
        }
        finally { isChangingPlan = false; }
    }

    private async Task ConfirmFreeDowngradeAsync()
    {
        if (isChangingPlan || selectedPlanChange is null) return;

        isChangingPlan = true;
        changePlanMessage = null;
        changePlanSucceeded = false;
        try
        {
            var result = await BillingService.DowngradeToFreeAsync(cancellationTokenSource.Token);
            await SessionManager.RefreshSessionAsync(cancellationTokenSource.Token);
            changePlanSucceeded = true;
            changePlanMessage = result.Changed
                ? "Tu plan se cambió a Gratuito."
                : "Ya tienes el plan Gratuito.";
            await LoadPlansAsync();
            selectedPlanChange = plans.FirstOrDefault(IsFreePlan);
        }
        catch (ApiException exception) when (exception.StatusCode == 401)
        {
            await SessionManager.ClearAsync();
            Navigation.NavigateTo("/login", replace: true);
        }
        catch (ApiException exception)
        {
            changePlanMessage = ApiErrorMessages.For(exception, "No pudimos cambiar tu plan a Gratuito.");
        }
        catch (OperationCanceledException) when (cancellationTokenSource.IsCancellationRequested)
        {
        }
        catch
        {
            changePlanMessage = "No pudimos cambiar tu plan a Gratuito. Inténtalo nuevamente.";
        }
        finally { isChangingPlan = false; }
    }

    private decimal GetPlanPrice(PlanDto plan) => billingCycle == "yearly" ? plan.PriceYearly : plan.PriceMonthly;

    private bool IsDemoPaymentValid()
    {
        return CardDigits.Length is >= 13 and <= 16 && PassesLuhn(CardDigits)
            && IsExpiryValid() && demoCvv.All(char.IsDigit) && demoCvv.Length is 3 or 4
            && !cardHadInvalidCharacters && !expiryHadInvalidCharacters && !cvvHadInvalidCharacters;
    }

    private void HandleCardNumberInput(ChangeEventArgs args)
    {
        var raw = args.Value?.ToString() ?? string.Empty;
        cardHadInvalidCharacters = raw.Any(character => !char.IsDigit(character) && !char.IsWhiteSpace(character) && character != '-');
        var digits = new string(raw.Where(char.IsDigit).Take(16).ToArray());
        demoCardNumber = string.Join(" ", digits.Chunk(4).Select(chunk => new string(chunk)));
        changePlanMessage = null;
    }

    private void HandleExpiryInput(ChangeEventArgs args)
    {
        var raw = args.Value?.ToString() ?? string.Empty;
        expiryHadInvalidCharacters = raw.Any(character => !char.IsDigit(character) && character != '/');
        var digits = new string(raw.Where(char.IsDigit).Take(4).ToArray());
        demoExpiry = digits.Length > 2 ? $"{digits[..2]}/{digits[2..]}" : digits;
        changePlanMessage = null;
    }

    private void HandleCvvInput(ChangeEventArgs args)
    {
        var raw = args.Value?.ToString() ?? string.Empty;
        cvvHadInvalidCharacters = raw.Any(character => !char.IsDigit(character));
        demoCvv = new string(raw.Where(char.IsDigit).Take(4).ToArray());
        changePlanMessage = null;
    }

    private bool IsExpiryValid()
    {
        if (demoExpiry.Length != 5 || demoExpiry[2] != '/' ||
            !int.TryParse(demoExpiry[..2], out var month) ||
            !int.TryParse(demoExpiry[3..], out var year)) return false;

        if (month is < 1 or > 12) return false;
        var now = DateTime.UtcNow;
        return year > now.Year % 100 || year == now.Year % 100 && month >= now.Month;
    }

    private static bool PassesLuhn(string digits)
    {
        var sum = 0;
        var alternate = false;
        for (var index = digits.Length - 1; index >= 0; index--)
        {
            var value = digits[index] - '0';
            if (alternate && (value *= 2) > 9) value -= 9;
            sum += value;
            alternate = !alternate;
        }
        return sum % 10 == 0;
    }

    private static string DetectCardBrand(string value)
    {
        var digits = new string(value.Where(char.IsDigit).ToArray());
        if (digits.StartsWith("4", StringComparison.Ordinal)) return "VISA";
        if (digits.Length >= 2 && int.TryParse(digits[..2], out var prefix) && prefix is >= 51 and <= 55) return "Mastercard";
        if (digits.StartsWith("6", StringComparison.Ordinal)) return "Kueski / débito";
        if (digits.StartsWith("3", StringComparison.Ordinal)) return "American Express";
        return string.Empty;
    }

    public void Dispose() => cancellationTokenSource.Cancel();
}
