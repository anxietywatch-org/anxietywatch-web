@page "/dashboard/tokens"
@layout DashboardLayout
@using AnxietyWatch.Web.Client.Models.Api
@inject ITokenService TokenService
@inject IAuthSessionManager SessionManager
@inject IJSRuntime JS
@inject NavigationManager Navigation

<PageTitle>Tokens de vinculación | AnxietyWatch</PageTitle>

<section class="tokens-page" aria-labelledby="tokens-page-title">
    <header class="page-header">
        <span class="page-header__icon" aria-hidden="true">
            <svg viewBox="0 0 24 24"><path d="M9.5 14.5 14.5 9M7 17l-1.5 1.5a3.5 3.5 0 0 1-5-5L5 9a3.5 3.5 0 0 1 5 0m7 6a3.5 3.5 0 0 0 5 0l1.5-1.5a3.5 3.5 0 0 0-5-5L14 13a3.5 3.5 0 0 0 0 5" /></svg>
        </span>
        <div>
            <h1 id="tokens-page-title">Tokens de vinculación</h1>
            <p>Gestiona los códigos de vinculación de tu plan.</p>
        </div>
    </header>

    @if (!string.IsNullOrWhiteSpace(pageMessage))
    {
        <aside class="operation-message @(pageMessageIsError ? "operation-message--error" : "operation-message--success")" role="@(pageMessageIsError ? "alert" : "status")">
            <span>@pageMessage</span>
            @if (loadFailed)
            {
                <button type="button" @onclick="LoadTokensAsync" disabled="@isLoading">Reintentar</button>
            }
        </aside>
    }

    <div class="tokens-layout">
        <div class="tokens-main">
            <section class="metrics-grid" aria-label="Resumen de tokens">
                <article class="metric-card">
                    <span class="metric-icon metric-icon--sage" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M5 5h14v14H5zM8 9h8m-8 3h8m-8 3h5" /></svg></span>
                    <div><span>Límite del plan</span><strong>@planLimit Tokens</strong></div>
                </article>
                <article class="metric-card">
                    <span class="metric-icon metric-icon--teal" aria-hidden="true"><svg viewBox="0 0 24 24"><circle cx="12" cy="8" r="3" /><path d="M5 20c.5-5 2.8-7.5 7-7.5s6.5 2.5 7 7.5" /></svg></span>
                    <div><span>Pendientes</span><strong>@pendingTokenCount tokens</strong></div>
                </article>
                <article class="metric-card">
                    <span class="metric-icon metric-icon--mint" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M12 5v14M5 12h14" /><circle cx="12" cy="12" r="9" /></svg></span>
                    <div><span>Aceptados</span><strong>@acceptedTokenCount tokens</strong></div>
                </article>
                <article class="metric-card metric-card--usage" aria-label="Uso de tokens: @usagePercent por ciento">
                    <svg class="usage-ring" viewBox="0 0 42 42" aria-hidden="true">
                        <circle class="usage-ring__track" cx="21" cy="21" r="15.9" pathLength="100" />
                        <circle class="usage-ring__value" cx="21" cy="21" r="15.9" pathLength="100" stroke-dasharray="@($"{usagePercent} {100 - usagePercent}")" />
                        <text x="21" y="23">@usagePercent%</text>
                    </svg>
                    <div><span>Cuota utilizada</span><strong>@quotaTokenCount de @planLimit</strong></div>
                </article>
            </section>

            <aside class="token-alert" role="note" aria-label="Información importante sobre tokens">
                <span aria-hidden="true">!</span><p>@pendingTokenCount pendientes · @expiredTokenCount expirados · @acceptedTokenCount aceptados. La cuota cuenta todos los tokens que el backend no haya eliminado.</p>
            </aside>

            <section class="tokens-table-card" aria-labelledby="tokens-table-title">
                <header class="table-header">
                    <div><h2 id="tokens-table-title">Tokens del plan</h2><p>Códigos generados para vincular usuarios a tu plan.</p></div>
                    <div class="table-header__actions">
                        <button class="export-token-action" type="button" @onclick="ExportTokensAsync" disabled="@(isLoading || mutationInProgress || allTokens.Count == 0)">Exportar</button>
                        <button class="new-token-action" type="button" @onclick="OpenTokenModal" disabled="@(isLoading || mutationInProgress)"><span aria-hidden="true">+</span>Nuevo token</button>
                    </div>
                </header>

                @if (isLoading)
                {
                    <div class="table-state" role="status">Cargando tokens...</div>
                }
                else if (!loadFailed && visibleTokens.Count == 0)
                {
                    <div class="table-state"><strong>Aún no hay tokens.</strong><span>Genera uno para comenzar a vincular usuarios.</span></div>
                }
                else if (!loadFailed)
                {
                    <div class="table-scroll responsive-table">
                        <table>
                            <caption class="visually-hidden">Listado de tokens de vinculación</caption>
                            <thead><tr><th scope="col">#</th><th scope="col">Tipo</th><th scope="col">Código</th><th scope="col">Expira</th><th scope="col">Estado</th><th scope="col">Acciones</th></tr></thead>
                            <tbody>
                                @for (var index = 0; index < visibleTokens.Count; index++)
                                {
                                    var token = visibleTokens[index];
                                    <tr @key="token.Id">
                                        <td>@(index + 1)</td>
                                        <td>@GetRoleLabel(token.Role)</td>
                                        <td><code>@MaskToken(token.Code)</code></td>
                                        <td>@token.ExpiresAt.ToLocalTime().ToString("dd/MM/yyyy")</td>
                                        <td><span class="status-badge @GetStatusClass(token)">@GetStatusLabel(token)</span></td>
                                        <td>
                                            <div class="row-actions">
                                                <button type="button" aria-label="Copiar token" title="Copiar" @onclick="() => CopyTokenAsync(token.Code)" disabled="@mutationInProgress"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="8" y="8" width="11" height="11" rx="2" /><path d="M16 8V6a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h2" /></svg></button>
                                                @if (HasStatus(token, "accepted"))
                                                {
                                                    <button type="button" aria-label="Revocar token" title="Revocar" @onclick="() => RevokeTokenAsync(token)" disabled="@mutationInProgress"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9.5 14.5 5-5M7 17l-1.5 1.5a3.5 3.5 0 0 1-5-5L5 9a3.5 3.5 0 0 1 5 0m7 6a3.5 3.5 0 0 0 5 0l1.5-1.5a3.5 3.5 0 0 0-5-5L14 13a3.5 3.5 0 0 0 0 5" /></svg></button>
                                                }
                                                <button type="button" aria-label="Eliminar token" title="@(CanDelete(token) ? "Eliminar" : "Solo los tokens pendientes pueden eliminarse")" @onclick="() => OpenDeleteModal(token)" disabled="@(mutationInProgress || !CanDelete(token))"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16m-10 4v5m4-5v5M8 7l1-3h6l1 3m2 0-1 13H7L6 7" /></svg></button>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                <footer class="table-footer"><span>Los tokens muestran la fecha de expiración informada por el servicio.</span></footer>
            </section>
        </div>

        <aside class="tokens-sidebar" aria-label="Información sobre tokens">
            <section class="info-card" aria-labelledby="how-tokens-title">
                <h2 id="how-tokens-title">¿Cómo funciona?</h2>
                <ol class="how-list"><li><span>1</span><p>Genera un token de vinculación.</p></li><li><span>2</span><p>Compártelo de forma privada.</p></li><li><span>3</span><p>El usuario ingresa el código.</p></li><li><span>4</span><p>Su cuenta se vincula al plan.</p></li><li><span>5</span><p>El token queda invalidado.</p></li></ol>
            </section>
            <section class="info-card security-card" aria-labelledby="security-title">
                <span class="security-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M12 3 5 6v5c0 4.8 2.8 8.2 7 10 4.2-1.8 7-5.2 7-10V6l-7-3Z" /><path d="m9 12 2 2 4-4" /></svg></span>
                <div><h2 id="security-title">Seguridad</h2><p>Cada código es único, de un solo uso y tiene una fecha de expiración.</p></div>
            </section>
        </aside>
    </div>

    @if (showTokenModal)
    {
        <div class="token-modal-overlay" role="presentation" @onclick="CloseTokenModal">
            <section class="token-modal" role="dialog" aria-modal="true" aria-labelledby="token-modal-title" @onclick:stopPropagation="true">
                <header class="token-modal__header">
                    <span class="token-modal__key" aria-hidden="true"><svg viewBox="0 0 24 24"><circle cx="8" cy="12" r="4" /><path d="M12 12h9m-3 0v3m-3-3v2" /></svg></span>
                    <h2 id="token-modal-title">Nuevo token</h2>
                    <button type="button" aria-label="Cerrar modal" @onclick="CloseTokenModal" disabled="@isCreating">×</button>
                </header>
                <div class="token-usage-banner"><span>Cuota utilizada</span><strong>@quotaTokenCount de @planLimit</strong></div>
                @if (generatedToken is not null)
                {
                    <section class="generated-token" aria-labelledby="generated-token-title">
                        <h3 id="generated-token-title">Token generado</h3>
                        <div class="generated-token__field"><code>@generatedToken.Code</code><button type="button" @onclick="() => CopyTokenAsync(generatedToken.Code)" aria-label="Copiar token generado"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="8" y="8" width="11" height="11" rx="2" /><path d="M16 8V6a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h2" /></svg>Copiar</button></div>
                        <p>Expira el @(generatedToken.ExpiresAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")).</p>
                    </section>
                }
                else if (isLimitReached)
                {
                    <section class="limit-reached" aria-labelledby="limit-reached-title"><span class="limit-reached__icon" aria-hidden="true">!</span><h3 id="limit-reached-title">Límite alcanzado</h3><p>Tu plan permite hasta @planLimit tokens activos. Elimina uno existente o actualiza tu plan.</p><button type="button" @onclick="CloseTokenModal">Entendido</button></section>
                }
                else
                {
                    <section class="token-type-section" aria-labelledby="token-type-title">
                        <h3 id="token-type-title">Tipo de token</h3>
                        <div class="token-type-options" role="radiogroup" aria-labelledby="token-type-title">
                            @foreach (var option in GetTokenRoles())
                            {
                                <button type="button" role="radio" aria-checked="@(selectedRole == option.Role)" class="@GetTokenTypeClass(option.Role)" @onclick="() => SelectRole(option.Role)" disabled="@isCreating">
                                    <span class="radio-indicator" aria-hidden="true"></span><span><strong>@option.Label</strong><small>@option.Description</small></span>
                                </button>
                            }
                        </div>
                    </section>
                    <button class="generate-token-button" type="button" @onclick="CreateTokenAsync" disabled="@isCreating">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 7v5h-5M4 17v-5h5m9.5-3A7 7 0 0 0 6 7m-.5 8A7 7 0 0 0 18 17" /></svg>@(isCreating ? "Generando..." : "Generar código")
                    </button>
                }
                @if (generatedToken is not null || !isLimitReached)
                {
                    @if (!string.IsNullOrWhiteSpace(modalMessage)) { <p class="modal-message" role="alert">@modalMessage</p> }
                    <footer class="token-modal__actions"><button class="token-modal-button token-modal-button--cancel" type="button" @onclick="CloseTokenModal" disabled="@isCreating">@(generatedToken is null ? "Cancelar" : "Cerrar")</button></footer>
                }
            </section>
        </div>
    }

    @if (tokenPendingDeletion is not null)
    {
        <div class="token-modal-overlay" role="presentation" @onclick="CloseDeleteModal">
            <section class="token-modal token-delete-modal" role="dialog" aria-modal="true" aria-labelledby="delete-token-title" @onclick:stopPropagation="true">
                <span class="token-delete-modal__icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24"><path d="M4 7h16m-10 4v5m4-5v5M8 7l1-3h6l1 3m2 0-1 13H7L6 7" /></svg>
                </span>
                <h2 id="delete-token-title">¿Eliminar este token?</h2>
                <p>Esta acción no se puede deshacer. El código dejará de poder usarse para vincularse.</p>
                <footer class="token-modal__actions">
                    <button class="token-modal-button token-modal-button--cancel" type="button" @onclick="CloseDeleteModal" disabled="@isDeleting">Cancelar</button>
                    <button class="token-modal-button token-modal-button--danger" type="button" @onclick="ConfirmDeleteTokenAsync" disabled="@isDeleting">@(isDeleting ? "Eliminando..." : "Eliminar")</button>
                </footer>
            </section>
        </div>
    }

</section>

@code {
    [SupplyParameterFromQuery(Name = "new")] public bool NewTokenRequested { get; set; }

    private readonly List<LinkTokenDto> allTokens = [];
    private List<LinkTokenDto> visibleTokens = [];
    private bool isLoading = true;
    private bool loadFailed;
    private bool hasLoaded;
    private bool showTokenModal;
    private bool isCreating;
    private bool isDeleting;
    private bool isRevoking;
    private bool isExporting;
    private int planLimit = 1;
    private int quotaTokenCount;
    private string selectedRole = "self";
    private string? pageMessage;
    private bool pageMessageIsError;
    private string? modalMessage;
    private LinkTokenDto? generatedToken;
    private LinkTokenDto? tokenPendingDeletion;

    private int pendingTokenCount => allTokens.Count(token => HasStatus(token, "pending") && !IsVisuallyExpired(token));
    private int expiredTokenCount => allTokens.Count(IsExpired);
    private int acceptedTokenCount => allTokens.Count(token => HasStatus(token, "accepted"));
    private int usagePercent => planLimit == 0 ? 0 : Math.Min(100, (int)Math.Round(quotaTokenCount * 100d / planLimit));
    private bool isLimitReached => quotaTokenCount >= planLimit;
    private bool mutationInProgress => isCreating || isDeleting || isRevoking || isExporting;

    protected override async Task OnInitializedAsync()
    {
        var user = SessionManager.CurrentUser;
        if (user is null)
        {
            Navigation.NavigateTo("/login", replace: true);
            return;
        }

        EnsureSelectedRoleIsValid();
        await LoadTokensAsync();
        hasLoaded = true;
        if (NewTokenRequested) OpenTokenModal();
    }

    protected override void OnParametersSet()
    {
        if (hasLoaded && NewTokenRequested) OpenTokenModal();
    }

    private async Task LoadTokensAsync()
    {
        isLoading = true;
        loadFailed = false;
        pageMessage = null;
        try
        {
            var tokens = await TokenService.GetTokensAsync();
            var quota = await TokenService.GetQuotaAsync();
            allTokens.Clear();
            allTokens.AddRange(tokens);
            planLimit = quota.Limit;
            quotaTokenCount = quota.Used;
            RefreshVisibleTokens();
        }
        catch (ApiException exception)
        {
            loadFailed = true;
            await HandleApiExceptionAsync(exception, "No pudimos cargar los tokens.");
        }
        catch
        {
            loadFailed = true;
            SetPageMessage("No pudimos cargar los tokens. Inténtalo nuevamente.", true);
        }
        finally { isLoading = false; }
    }

    private async Task CreateTokenAsync()
    {
        if (isCreating || isLimitReached) return;
        isCreating = true;
        modalMessage = null;
        try
        {
            generatedToken = await TokenService.CreateTokenAsync(new CreateTokenRequest { Role = selectedRole });
            allTokens.Add(generatedToken);
            await RefreshQuotaAsync();
            RefreshVisibleTokens();
        }
        catch (ApiException exception) { modalMessage = await HandleApiExceptionAsync(exception); }
        catch { modalMessage = "No pudimos generar el token. Inténtalo nuevamente."; }
        finally { isCreating = false; }
    }

    private async Task DeleteTokenAsync(LinkTokenDto token)
    {
        if (isDeleting || !Guid.TryParse(token.Id, out var id))
        {
            if (!Guid.TryParse(token.Id, out _)) SetPageMessage("El identificador del token no es válido.", true);
            return;
        }

        isDeleting = true;
        SetPageMessage(null, false);
        try
        {
            await TokenService.DeleteTokenAsync(id);
            allTokens.Remove(token);
            await RefreshQuotaAsync();
            RefreshVisibleTokens();
            SetPageMessage("Token eliminado correctamente.", false);
        }
        catch (ApiException exception) when (exception.StatusCode == 409)
        {
            SetPageMessage("El token ya no se puede eliminar por su estado actual.", true);
        }
        catch (ApiException exception) { await HandleApiExceptionAsync(exception, "No pudimos eliminar el token."); }
        catch { SetPageMessage("No pudimos eliminar el token. Inténtalo nuevamente.", true); }
        finally { isDeleting = false; }
    }

    private void OpenDeleteModal(LinkTokenDto token)
    {
        if (!CanDelete(token) || mutationInProgress) return;

        SetPageMessage(null, false);
        tokenPendingDeletion = token;
    }

    private void CloseDeleteModal()
    {
        if (isDeleting) return;

        tokenPendingDeletion = null;
        SetPageMessage(null, false);
    }

    private async Task ConfirmDeleteTokenAsync()
    {
        if (tokenPendingDeletion is not { } token || isDeleting) return;

        await DeleteTokenAsync(token);
        tokenPendingDeletion = null;
    }

    private async Task RevokeTokenAsync(LinkTokenDto token)
    {
        if (isRevoking || !Guid.TryParse(token.Id, out var id))
        {
            if (!Guid.TryParse(token.Id, out _)) SetPageMessage("El identificador del token no es válido.", true);
            return;
        }

        var confirmed = await JS.InvokeAsync<bool>("confirm", "¿Revocar este token? El dispositivo vinculado dejará de enviar datos al plan.");
        if (!confirmed) return;

        isRevoking = true;
        SetPageMessage(null, false);
        try
        {
            await TokenService.RevokeTokenAsync(id);
            allTokens.Remove(token);
            await RefreshQuotaAsync();
            RefreshVisibleTokens();
            SetPageMessage("Token revocado correctamente.", false);
        }
        catch (ApiException exception) when (exception.StatusCode == 409)
        {
            SetPageMessage("El token ya no se puede revocar por su estado actual.", true);
        }
        catch (ApiException exception) { await HandleApiExceptionAsync(exception, "No pudimos revocar el token."); }
        catch { SetPageMessage("No pudimos revocar el token. Inténtalo nuevamente.", true); }
        finally { isRevoking = false; }
    }

    private async Task ExportTokensAsync()
    {
        if (isExporting) return;
        isExporting = true;
        SetPageMessage(null, false);
        try
        {
            var export = await TokenService.ExportTokensAsync();
            await JS.InvokeVoidAsync(
                "anxietyWatch.downloadBytes",
                export.FileName,
                export.ContentType,
                export.Content);
            SetPageMessage("Exportación preparada correctamente.", false);
        }
        catch (ApiException exception) { await HandleApiExceptionAsync(exception, "No pudimos exportar los tokens."); }
        catch { SetPageMessage("No pudimos exportar los tokens. Inténtalo nuevamente.", true); }
        finally { isExporting = false; }
    }

    private async Task CopyTokenAsync(string code)
    {
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", code);
            SetPageMessage("Token copiado al portapapeles.", false);
        }
        catch { SetPageMessage("No se pudo copiar el token. Selecciónalo y cópialo manualmente.", true); }
    }

    private async Task<string> HandleApiExceptionAsync(ApiException exception, string fallback = "No pudimos completar la operación.")
    {
        var message = ApiErrorMessages.For(exception, fallback);
        if (exception.StatusCode == 401)
        {
            await SessionManager.ClearAsync();
            Navigation.NavigateTo("/login", replace: true);
        }
        else
        {
            SetPageMessage(message, true);
        }
        return message;
    }

    private void RefreshVisibleTokens() =>
        visibleTokens = allTokens.Where(token => !IsDeleted(token)).ToList();

    private void OpenTokenModal()
    {
        EnsureSelectedRoleIsValid();
        showTokenModal = true;
        generatedToken = null;
        modalMessage = null;
    }

    private void CloseTokenModal()
    {
        if (isCreating) return;
        showTokenModal = false;
        generatedToken = null;
        modalMessage = null;
        if (NewTokenRequested) Navigation.NavigateTo("/dashboard/tokens", replace: true);
    }

    private void SelectRole(string role)
    {
        selectedRole = role;
        generatedToken = null;
        modalMessage = null;
    }

    private void SetPageMessage(string? message, bool isError) => (pageMessage, pageMessageIsError) = (message, isError);
    private string GetTokenTypeClass(string role) => selectedRole == role ? "token-type-option is-selected" : "token-type-option";
    private (string Role, string Label, string Description)[] GetTokenRoles() =>
        SessionManager.CurrentUser?.PlanId?.ToLowerInvariant() switch
        {
            "individual" => [("self", "Paciente", "Vincula tu cuenta individual")],
            "family" =>
            [
                ("patient", "Paciente", "Invita al paciente a vincularse"),
                ("family_member", "Cuidador/familiar", "Invita a un cuidador o familiar")
            ],
            "professional" =>
            [
                ("patient", "Paciente", "Invita a un paciente a vincularse"),
                ("family_member", "Colaborador/profesional", "Invita a un colaborador o profesional a vincularse")
            ],
            _ => [("self", "App Móvil (yo)", "Vincula tu dispositivo personal")]
        };

    private void EnsureSelectedRoleIsValid()
    {
        var availableRoles = GetTokenRoles();
        if (!availableRoles.Any(option => string.Equals(option.Role, selectedRole, StringComparison.OrdinalIgnoreCase)))
        {
            selectedRole = availableRoles[0].Role;
        }
    }

    private async Task RefreshQuotaAsync()
    {
        var quota = await TokenService.GetQuotaAsync();
        planLimit = quota.Limit;
        quotaTokenCount = quota.Used;
    }

    private string GetRoleLabel(string role)
    {
        var availableRole = GetTokenRoles().FirstOrDefault(option =>
            string.Equals(option.Role, role, StringComparison.OrdinalIgnoreCase));
        if (!string.IsNullOrEmpty(availableRole.Role)) return availableRole.Label;

        return role.ToLowerInvariant() switch { "self" => "App Móvil (yo)", "family_member" => "Miembro familiar", "patient" => "Paciente", _ => role };
    }
    private static string MaskToken(string code) => code.Length <= 4 ? "••••" : $"••••-{code[^4..]}";
    private static bool HasStatus(LinkTokenDto token, string status) =>
        string.Equals(token.Status, status, StringComparison.OrdinalIgnoreCase);
    private static bool IsDeleted(LinkTokenDto token) => HasStatus(token, "deleted");
    private static bool IsVisuallyExpired(LinkTokenDto token) =>
        HasStatus(token, "pending") && token.ExpiresAt <= DateTimeOffset.UtcNow;
    private static bool IsExpired(LinkTokenDto token) =>
        HasStatus(token, "expired") || IsVisuallyExpired(token);
    private static bool CanDelete(LinkTokenDto token) => HasStatus(token, "pending");
    private static string GetStatusLabel(LinkTokenDto token) => IsVisuallyExpired(token)
        ? "Expirado"
        : token.Status.ToLowerInvariant() switch { "accepted" => "Aceptado", "pending" => "Pendiente", "expired" => "Expirado", _ => token.Status };
    private static string GetStatusClass(LinkTokenDto token) => IsVisuallyExpired(token)
        ? "status-badge--expired"
        : token.Status.ToLowerInvariant() switch { "accepted" => "status-badge--used", "pending" => "status-badge--pending", "expired" => "status-badge--expired", _ => "status-badge--available" };
}
