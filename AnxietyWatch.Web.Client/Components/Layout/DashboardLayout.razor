@inherits LayoutComponentBase
@inject IServiceProvider Services
@inject NavigationManager Navigation
@implements IDisposable

@if (!string.IsNullOrWhiteSpace(sessionError))
{
    <div class="dashboard-session-loading dashboard-session-error" role="alert">
        <span>@sessionError</span>
        <button type="button" disabled="@sessionRetryPending" @onclick="RetrySessionAsync">
            @(sessionRetryPending ? "Validando..." : "Reintentar")
        </button>
    </div>
}
else if (!sessionReady)
{
    <div class="dashboard-session-loading" role="status">Restaurando tu sesión...</div>
}
else
{
<div class="dashboard-shell" @onkeydown="OnKeyDown">
    <aside class="dashboard-sidebar">
        <a class="sidebar-brand" href="/dashboard/tokens" aria-label="Ir a tokens de vinculación">
            <span class="brand-mark" aria-hidden="true">
                <svg viewBox="0 0 24 24" role="img">
                    <path d="M12 21c4.5-2.7 7-6.4 7-10.2A4.8 4.8 0 0 0 14.2 6c-.9 0-1.7.2-2.2.8A3 3 0 0 0 9.8 6 4.8 4.8 0 0 0 5 10.8C5 14.6 7.5 18.3 12 21Z" />
                    <path d="M8.3 12h2l1.1-2.3 1.6 4.6 1.1-2.3h1.8" />
                </svg>
            </span>
            <span>AnxietyWatch</span>
        </a>

        <nav class="sidebar-nav @(isMenuOpen ? "sidebar-nav--open" : "")" aria-label="Navegación del dashboard">
            <NavLink class="sidebar-link" href="/dashboard" Match="NavLinkMatch.All">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M4 13h6V4H4v9Zm0 7h6v-4H4v4Zm10 0h6v-9h-6v9Zm0-16v4h6V4h-6Z" />
                </svg>
                <span>Resumen</span>
            </NavLink>

            <NavLink class="sidebar-link" href="/dashboard/tokens" Match="NavLinkMatch.All">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M9.5 14.5 14.5 9M7 17l-1.5 1.5a3.5 3.5 0 0 1-5-5L5 9a3.5 3.5 0 0 1 5 0m7 6a3.5 3.5 0 0 0 5 0l1.5-1.5a3.5 3.5 0 0 0-5-5L14 13a3.5 3.5 0 0 0 0 5" />
                </svg>
                <span>Tokens de vinculación</span>
            </NavLink>

            <NavLink class="sidebar-link" href="/caregiver/patients">
                <span aria-hidden="true">♥</span>
                <span>Personas vinculadas</span>
            </NavLink>

            <NavLink class="sidebar-link" href="/dashboard/plan" Match="NavLinkMatch.All">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M4 7.5h16v11H4v-11Zm3-3h10v3H7v-3Zm1 7h8m-8 3h5" />
                </svg>
                <span>Mi plan</span>
            </NavLink>

            <NavLink class="sidebar-link" href="/dashboard/help" Match="NavLinkMatch.All">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                    <circle cx="12" cy="12" r="9" />
                    <path d="M9.8 9a2.4 2.4 0 0 1 4.6 1c0 2-2.4 2.2-2.4 4m0 3h.01" />
                </svg>
                <span>Centro de ayuda</span>
            </NavLink>

        </nav>

    </aside>

    <div class="dashboard-workspace">
        <header class="dashboard-topbar">
            <button class="hamburger-btn" type="button" aria-label="Abrir menú" aria-expanded="@isMenuOpen" aria-controls="sidebar-nav" @onclick="ToggleMenu">
                <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                    <path d="M3 6h18" />
                    <path d="M3 12h18" />
                    <path d="M3 18h18" />
                </svg>
            </button>
            <div class="topbar-actions">
                <a class="new-token-button" href="/dashboard/tokens?new=true">
                    <span aria-hidden="true">+</span>
                    Nuevo token
                </a>

                <details class="user-menu">
                    <summary class="user-profile" aria-label="Abrir menú del perfil de @(CurrentUser!.FullName)">
                        @if (IsSafeAvatarUrl(CurrentUser.AvatarUrl))
                        {
                            <img class="user-avatar user-avatar--image" src="@CurrentUser.AvatarUrl" alt="" />
                        }
                        else
                        {
                            <span class="user-avatar" aria-hidden="true">@Initials</span>
                        }
                        <span class="user-copy">
                            <strong>@CurrentUser.FullName</strong>
                            <small>Plan @PlanName</small>
                        </span>
                        <svg class="profile-chevron" viewBox="0 0 24 24" aria-hidden="true">
                            <path d="m8 10 4 4 4-4" />
                        </svg>
                    </summary>

                    <div class="profile-dropdown">
                        <header class="profile-dropdown__header">
                            @if (IsSafeAvatarUrl(CurrentUser.AvatarUrl))
                            {
                                <img class="user-avatar user-avatar--large user-avatar--image" src="@CurrentUser.AvatarUrl" alt="" />
                            }
                            else
                            {
                                <span class="user-avatar user-avatar--large" aria-hidden="true">@Initials</span>
                            }
                            <span class="profile-dropdown__identity">
                                <strong>@CurrentUser.FullName</strong>
                                <small>@CurrentUser.Email</small>
                                <span>Plan @PlanName</span>
                            </span>
                        </header>

                        <hr />

                        <nav class="profile-dropdown__links" aria-label="Opciones del perfil">
                            <a href="/dashboard/profile">
                                <svg viewBox="0 0 24 24" aria-hidden="true">
                                    <circle cx="12" cy="8" r="3.5" />
                                    <path d="M5 20c.5-5 2.8-7.5 7-7.5s6.5 2.5 7 7.5" />
                                </svg>
                                <span>Mi perfil</span>
                            </a>
                            <a href="/dashboard/billing">
                                <svg viewBox="0 0 24 24" aria-hidden="true">
                                    <rect x="3" y="5" width="18" height="14" rx="3" />
                                    <path d="M3 9h18M7 15h4" />
                                </svg>
                                <span>Facturación</span>
                            </a>

                            <hr />

                            <button class="profile-logout" type="button" disabled="@logoutPending" @onclick="LogoutAsync">
                                <svg viewBox="0 0 24 24" aria-hidden="true">
                                    <path d="M10 5H5v14h5m4-4 4-3-4-3m4 3H9" />
                                </svg>
                                <span>@(logoutPending ? "Cerrando sesión..." : "Cerrar sesión")</span>
                            </button>
                        </nav>
                    </div>
                </details>
            </div>
        </header>

        <div class="@(isMenuOpen ? "menu-overlay menu-overlay--open" : "menu-overlay")" @onclick="() => isMenuOpen = false" role="presentation"></div>

        <main class="dashboard-main">
            @Body
        </main>
    </div>
</div>
}

@code {
    private UserDto? CurrentUser;
    private bool sessionReady;
    private bool logoutPending;
    private bool sessionRetryPending;
    private string? sessionError;
    private IAuthSessionManager? sessionManager;

    private IAuthSessionManager SessionManager => sessionManager ??=
        (IAuthSessionManager)(Services.GetService(typeof(IAuthSessionManager))
            ?? throw new InvalidOperationException("IAuthSessionManager no está disponible en el cliente."));
    private IAuthService AuthService => (IAuthService)(Services.GetService(typeof(IAuthService))
        ?? throw new InvalidOperationException("IAuthService no está disponible en el cliente."));

    private string Initials => GetInitials(CurrentUser?.FullName ?? string.Empty);
    private string PlanName => (CurrentUser?.PlanId ?? string.Empty).Trim().ToLowerInvariant() switch
    {
        "free" => "Gratuito",
        "individual" => "Individual",
        "family" => "Familiar",
        "professional" => "Profesional",
        var planId => string.IsNullOrWhiteSpace(planId) ? "sin asignar" : planId
    };

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        SessionManager.SessionChanged += HandleSessionChanged;
        try
        {
            await ApplySessionStateAsync(await SessionManager.InitializeAsync());
        }
        catch
        {
            sessionError = "No pudimos restaurar tu sesión. Intenta iniciar sesión nuevamente.";
            sessionReady = false;
            StateHasChanged();
        }
    }

    private async Task RetrySessionAsync()
    {
        if (sessionRetryPending) return;
        sessionRetryPending = true;
        sessionError = null;
        try
        {
            await ApplySessionStateAsync(await SessionManager.RetryInitializationAsync());
        }
        catch
        {
            sessionError = "No pudimos restaurar tu sesión. Intenta iniciar sesión nuevamente.";
            sessionReady = false;
        }
        finally
        {
            sessionRetryPending = false;
        }
    }

    private Task ApplySessionStateAsync(bool isAuthenticated)
    {
        if (!string.IsNullOrWhiteSpace(SessionManager.InitializationError))
        {
            sessionError = SessionManager.InitializationError;
            StateHasChanged();
            return Task.CompletedTask;
        }

        CurrentUser = SessionManager.CurrentUser;
        if (!isAuthenticated || CurrentUser is null)
        {
            Navigation.NavigateTo("/login", replace: true);
            return Task.CompletedTask;
        }

        sessionReady = true;
        StateHasChanged();
        return Task.CompletedTask;
    }

    private async Task LogoutAsync()
    {
        if (logoutPending)
        {
            return;
        }

        logoutPending = true;
        try
        {
            await AuthService.LogoutAsync();
        }
        finally
        {
            Navigation.NavigateTo("/login", replace: true);
        }
    }

    private void HandleSessionChanged()
    {
        _ = InvokeAsync(() =>
        {
            CurrentUser = SessionManager.CurrentUser;
            sessionReady = CurrentUser is not null;
            StateHasChanged();
        });
    }

    private bool isMenuOpen;

    private void ToggleMenu()
    {
        isMenuOpen = !isMenuOpen;
    }

    private void OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape" && isMenuOpen)
        {
            isMenuOpen = false;
            StateHasChanged();
        }
    }

    private static string GetInitials(string name)
    {
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
        return parts.Length switch
        {
            0 => "?",
            1 => parts[0][..1].ToUpperInvariant(),
            _ => string.Concat(parts[0][0], parts[^1][0]).ToUpperInvariant()
        };
    }

    private static bool IsSafeAvatarUrl(string? avatarUrl) =>
        Uri.TryCreate(avatarUrl, UriKind.Absolute, out var uri) && uri.Scheme == Uri.UriSchemeHttps;

    public void Dispose()
    {
        if (sessionManager is not null)
        {
            sessionManager.SessionChanged -= HandleSessionChanged;
        }
        Navigation.LocationChanged -= OnLocationChanged;
    }

    protected override void OnInitialized()
    {
        Navigation.LocationChanged += OnLocationChanged;
        base.OnInitialized();
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        if (isMenuOpen)
        {
            isMenuOpen = false;
            StateHasChanged();
        }
    }
}
