@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <ResourcePreloader />
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 16'%3E%3Cpath fill='%23225c8d' d='M8 15s-6-3.6-6-8.2C2 4.2 3.8 2 6.2 2 7.4 2 8 2.8 8 3.5 8 2.8 8.6 2 9.8 2 12.2 2 14 4.2 14 6.8 14 11.4 8 15 8 15Z'/%3E%3C/svg%3E" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["AnxietyWatch.Web.styles.css"]" />
    <ImportMap nonce="@CspNonce" />
    <HeadOutlet />
</head>

<body>
    <ClientRoutes @rendermode="ClientRenderModes.WebAssembly" />
    <script src="download.js"></script>
    <script src="verify-email.js"></script>
    <script src="@Assets["_framework/blazor.web.js"]"></script>
</body>

</html>

@code {
    private string CspNonce => HttpContextAccessor.HttpContext?.Items["CspNonce"]?.ToString() ?? string.Empty;
}
