@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <ResourcePreloader />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["AnxietyWatch.Web.styles.css"]" />
    <ImportMap nonce="@CspNonce" />
    <HeadOutlet />
</head>

<body>
    <Routes />
    <script src="download.js"></script>
    <script src="@Assets["_framework/blazor.web.js"]"></script>
</body>

</html>

@code {
    private string CspNonce => HttpContextAccessor.HttpContext?.Items["CspNonce"]?.ToString() ?? string.Empty;
}
